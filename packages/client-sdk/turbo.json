{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/scripts/lib/rewriteDistImports.ts"
      ]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/.github/workflows/uncached-tests.yml"
      ]
    }
  }
}
