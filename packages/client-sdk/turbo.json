{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/scripts/lib/rewriteDistImports.ts"
      ]
    },
    "test": {
      "description": "The peer-refusal recovery scenarios judge their requests with the API's own peer rule, read from its source at run time (peerRefusalRecovery.testFixtures.ts).",
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "env": ["TEARLEADS_TEST_FAST_SIGNATURES"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/.github/workflows/uncached-tests.yml",
        "$TURBO_ROOT$/packages/api/src/documents/documentPeerOwners.ts",
        "$TURBO_ROOT$/packages/api/src/documents/documentPeerRowChunks.ts"
      ]
    }
  }
}
