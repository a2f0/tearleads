{
  "name": "@tearleads/client-sdk",
  "version": "0.1.0",
  "description": "React-free Tearleads client runtime and domain service facades.",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./documents": {
      "types": "./src/documents.ts",
      "default": "./src/documents.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite.ts",
      "default": "./src/sqlite.ts"
    },
    "./stores/documents": {
      "types": "./src/stores/documents/index.ts",
      "default": "./src/stores/documents/index.ts"
    },
    "./workflows/blobs": {
      "types": "./src/workflows/blobs/index.ts",
      "default": "./src/workflows/blobs/index.ts"
    },
    "./workflows/contacts": {
      "types": "./src/workflows/contacts/index.ts",
      "default": "./src/workflows/contacts/index.ts"
    },
    "./workflows/containers": {
      "types": "./src/workflows/containers/index.ts",
      "default": "./src/workflows/containers/index.ts"
    },
    "./workflows/documents": {
      "types": "./src/workflows/documents/index.ts",
      "default": "./src/workflows/documents/index.ts"
    },
    "./workflows/explorer": {
      "types": "./src/workflows/explorer/index.ts",
      "default": "./src/workflows/explorer/index.ts"
    },
    "./workflows/organizations": {
      "types": "./src/workflows/organizations/index.ts",
      "default": "./src/workflows/organizations/index.ts"
    },
    "./workflows/principals": {
      "types": "./src/workflows/principals/index.ts",
      "default": "./src/workflows/principals/index.ts"
    },
    "./workflows/registration": {
      "types": "./src/workflows/registration/index.ts",
      "default": "./src/workflows/registration/index.ts"
    },
    "./workflows/sync": {
      "types": "./src/workflows/sync/index.ts",
      "default": "./src/workflows/sync/index.ts"
    }
  },
  "scripts": {
    "test": "bun test src --max-concurrency=4 --pass-with-no-tests"
  },
  "dependencies": {
    "@tearleads/api-client": "workspace:*",
    "@tearleads/crypto": "workspace:*",
    "@tearleads/encoding": "workspace:*",
    "@tearleads/loro": "workspace:*",
    "@tearleads/validators": "workspace:*",
    "drizzle-orm": "0.45.1"
  },
  "devDependencies": {
    "@tearleads/sqlite-worker": "workspace:*",
    "@types/bun": "catalog:"
  }
}
