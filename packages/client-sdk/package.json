{
  "name": "@symcrypt/client-sdk",
  "version": "0.1.0",
  "description": "React-free SymCrypt client runtime with unified device-first reads, locally durable writes, bounded resumable headless document sync, background reconciliation, trusted identity, durable security-incident reporting, strict local organization, streamed encrypted blob storage, and sync diagnostics.",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./testing": {
      "types": "./dist/data/trustedUserIdentity/testFixtures.d.ts",
      "default": "./dist/data/trustedUserIdentity/testFixtures.js"
    }
  },
  "scripts": {
    "build": "sh scripts/build.sh",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun test src --max-concurrency=4 --pass-with-no-tests"
  },
  "dependencies": {
    "@symcrypt/api-client": "workspace:*",
    "@symcrypt/crypto": "workspace:*",
    "@symcrypt/encoding": "workspace:*",
    "@symcrypt/loro": "workspace:*",
    "@symcrypt/sqlite-worker": "workspace:*",
    "@symcrypt/validators": "workspace:*",
    "drizzle-orm": "0.45.1"
  },
  "devDependencies": {
    "@symcrypt/test-utils": "workspace:*",
    "@types/bun": "catalog:"
  }
}
