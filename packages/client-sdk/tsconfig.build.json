{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "inlineSources": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "tsBuildInfoFile": "tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.testFixtures.ts",
    "src/**/*.testUtils.ts",
    "test"
  ]
}
