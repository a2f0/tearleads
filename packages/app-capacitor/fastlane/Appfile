# Fastlane evals Appfile from either the package or fastlane directory. Prefer
# those supported working directories, with the Appfile directory as a fallback.
native_release_target_paths = %w[
  fastlane/lib/native_release_target.rb
  lib/native_release_target.rb
].map { |path| File.expand_path(path, Dir.pwd) }
native_release_target_paths << File.expand_path('lib/native_release_target.rb', __dir__)
native_release_target_path = native_release_target_paths.find { |path| File.file?(path) }
raise LoadError, 'Could not locate fastlane/lib/native_release_target.rb' if native_release_target_path.nil?

require File.realpath(native_release_target_path)

app_identifier(NATIVE_APP_IDENTIFIER)
package_name(NATIVE_APP_IDENTIFIER)
