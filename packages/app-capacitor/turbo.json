{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "passThroughEnv": [
        "FASTLANE_OPT_OUT_USAGE",
        "FASTLANE_SKIP_UPDATE_CHECK"
      ],
      "description": "Release and deploy suites read repository scripts, Terraform, Wrangler configurations, the agent-tool image targets, and other packages' deploy scripts by path. Explicit globs bypass .gitignore, so the negations keep local state and secrets out of the hash.",
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/agent-tool.json",
        "$TURBO_ROOT$/scripts/**",
        "!$TURBO_ROOT$/scripts/localstack/data/**",
        "$TURBO_ROOT$/terraform/scripts/**",
        "$TURBO_ROOT$/terraform/stacks/**/*.tf",
        "$TURBO_ROOT$/terraform/modules/**/*.tf",
        "$TURBO_ROOT$/terraform/stacks/**/scripts/**",
        "!$TURBO_ROOT$/terraform/**/.terraform/**",
        "$TURBO_ROOT$/packages/api/scripts/**",
        "$TURBO_ROOT$/packages/api/src/billing/returnOrigins.ts",
        "$TURBO_ROOT$/packages/api-cli/scripts/**",
        "$TURBO_ROOT$/packages/website/scripts/**",
        "$TURBO_ROOT$/packages/website/wrangler.jsonc",
        "$TURBO_ROOT$/packages/api/wrangler.jsonc",
        "$TURBO_ROOT$/packages/app-web/wrangler.*.jsonc",
        "$TURBO_ROOT$/packages/app-web/scripts/**"
      ]
    }
  }
}
