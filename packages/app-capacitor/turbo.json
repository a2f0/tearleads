        "$TURBO_ROOT$/scripts/deployStaging.sh",
        "$TURBO_ROOT$/scripts/destroyStaging.sh",
        "$TURBO_ROOT$/scripts/nativeRelease.sh",
        "$TURBO_ROOT$/scripts/releaseGuards.sh",
        "$TURBO_ROOT$/scripts/uploadAndroidRelease.sh",
        "$TURBO_ROOT$/scripts/uploadAndroidStagingRelease.sh",
        "$TURBO_ROOT$/scripts/uploadIosRelease.sh",
        "$TURBO_ROOT$/scripts/uploadIosStagingRelease.sh",
