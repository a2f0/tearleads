{
  "name": "app-capacitor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun run build:worker && bun run build:client-sdk",
    "dev": "vite",
    "prebuild": "bun run build:worker && bun run build:client-sdk",
    "build": "vite build",
    "build:worker": "bun run --silent scripts/buildWorker.ts",
    "build:client-sdk": "bun run --cwd ../client-sdk build",
    "cap:sync": "bun run cap:sync:debug",
    "cap:sync:debug": "CAPACITOR_BUILD_CONFIGURATION=Debug cap sync",
    "cap:sync:release": "CAPACITOR_BUILD_CONFIGURATION=Release cap sync",
    "cap:sync:staging": "NATIVE_RELEASE_TIER=staging CAPACITOR_BUILD_CONFIGURATION=Release-Staging cap sync",
    "cap:open:android": "cap open android",
    "cap:run:android": "cap run android",
    "cap:open:ios": "cap open ios",
    "cap:run:ios": "cap run ios",
    "android:build:debug": "bundle exec fastlane android build_debug",
    "android:build:release": "bundle exec fastlane android build_release",
    "android:build:google-play": "bundle exec fastlane android build_google_play_release",
    "android:upload:google-play": "bundle exec fastlane android upload_google_play_release",
    "android:sideload": "bundle exec fastlane android sideload",
    "android:sideload:debug": "bundle exec fastlane android install_debug",
    "android:sideload:release": "bundle exec fastlane android install_release",
    "ios:build:testflight": "bundle exec fastlane ios build_testflight_release",
    "ios:upload:testflight": "bundle exec fastlane ios upload_testflight_release",
    "ios:fetch:appstore-profile": "bundle exec fastlane ios fetch_appstore_profile",
    "ios:fetch:appstore-profile:staging": "NATIVE_RELEASE_TIER=staging bundle exec fastlane ios fetch_appstore_profile",
    "store:build-numbers": "bundle exec fastlane store_build_numbers",
    "lint:rubocop": "bundle exec rubocop",
    "test": "bun test src tests --pass-with-no-tests"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/app": "8.1.0",
    "@capacitor/camera": "8.2.1",
    "@capacitor/core": "8.4.0",
    "@capacitor/file-viewer": "2.0.1",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome/capacitor-file-picker": "8.0.2",
    "@capgo/capacitor-native-biometric": "8.4.5",
    "@revenuecat/purchases-capacitor": "13.2.1",
    "@tearleads/client-sdk": "workspace:*",
    "@tearleads/encoding": "workspace:*",
    "@tearleads/sqlite-worker": "workspace:*",
    "app": "workspace:*",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.0",
    "@capacitor/cli": "8.4.0",
    "@capacitor/ios": "8.4.0",
    "@types/bun": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.3",
    "vite-plugin-wasm": "3.6.0"
  }
}
