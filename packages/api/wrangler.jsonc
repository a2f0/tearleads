{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  // The API reaches PlanetScale in us-east-1 with many sequential queries per
  // request; run it next to the database rather than next to the client.
  // Keep the placement hint while measuring Hyperdrive. Smart Placement needs
  // sustained traffic from several locations before it can choose a region.
  "placement": { "region": "aws:us-east-1" },
  // Registration alone issues on the order of a thousand queries in one
  // transaction. CPU time is a fraction of its wall time, but the default
  // 30 s ceiling leaves no margin for verification-heavy requests.
  "limits": { "cpu_ms": 120000 },
  // Deployed tiers also log one request-cost line per request; see
  // docs/developer/api-request-cost.md.
  "observability": { "enabled": true },
  // Workers forbid compiling WebAssembly at runtime; the Loro alias target
  // initializes its web build from the module Wrangler compiles. The other
  // aliases stub the development-only database drivers the shared database
  // module imports statically; the Worker only ever selects Postgres.
  "alias": {
    "loro-crdt": "./src/worker/loro/index.ts",
    "@aws-sdk/xml-builder": "./src/worker/stubs/awsXmlBuilder.ts",
    "bun:sqlite": "./src/worker/stubs/bunSqlite.ts",
    "@electric-sql/pglite": "./src/worker/stubs/pglite.ts",
    "@libsql/client": "./src/worker/stubs/libsql.ts"
  },
  "triggers": {
    // Billing maintenance every minute and blob garbage collection hourly.
    // `scheduled` branches on the cron.
    "crons": ["* * * * *", "0 * * * *"]
  },
  // Declarative Durable Object lifecycle: a deploy creates a missing namespace
  // and keeps an existing one. A greenfield reset deletes both through the
  // tombstones in wrangler.maintenance.jsonc instead of deleting the Worker.
  "exports": {
    "KeyValueStore": { "type": "durable-object", "storage": "sqlite" },
    "RealtimeHub": { "type": "durable-object", "storage": "sqlite" }
  },
  // API_PUBLIC_ORIGIN, API_CORS_ORIGINS and API_BILLING_RETURN_ORIGINS are passed by
  // packages/api/scripts/deployApi.sh from TF_VAR_domain.
  "env": {
    // Local workerd integration tests use direct Postgres, without Hyperdrive.
    "local": {
      "name": "tearleads-platform-api-local",
      "vars": {
        "API_WORKER_LOCAL": "true",
        "BLOB_OBJECT_STORE": "s3",
        "BLOB_OBJECT_STORE_S3_BUCKET": "tearleads-workerd-test",
        "BLOB_OBJECT_STORE_S3_FORCE_PATH_STYLE": "false",
        "BLOB_OBJECT_STORE_S3_REGION": "us-east-1",
        "POSTGRES_COALESCE_WRITES": "true",
        "POSTGRES_POOL_MAX": "4",
        "POSTGRES_POOL_MAX_USES": "1",
        "POSTGRES_REQUEST_SCOPED": "true",
        "REALTIME_HUB_LOCATION_HINT": "enam"
      },
      "durable_objects": {
        "bindings": [
          { "name": "KEY_VALUE_STORE", "class_name": "KeyValueStore" },
          { "name": "REALTIME_HUB", "class_name": "RealtimeHub" }
        ]
      }
    },
    "staging": {
      "name": "tearleads-platform-api-staging",
      // deployApi.sh fills this from the tier's Terraform hyperdrive_id output.
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "HYPERDRIVE_ID_staging" }
      ],
      "vars": {
        "API_REQUEST_COST_LOG": "true",
        "API_SENTRY_ENVIRONMENT": "staging",
        "BLOB_OBJECT_STORE": "s3",
        "BLOB_OBJECT_STORE_S3_BUCKET": "tearleads-blobs-staging",
        "BLOB_OBJECT_STORE_S3_FORCE_PATH_STYLE": "true",
        "BLOB_OBJECT_STORE_S3_REGION": "auto",
        "POSTGRES_COALESCE_WRITES": "true",
        "POSTGRES_POOL_MAX": "4",
        "POSTGRES_POOL_MAX_USES": "1",
        "POSTGRES_REQUEST_SCOPED": "true",
        "REALTIME_HUB_LOCATION_HINT": "enam"
      },
      "durable_objects": {
        "bindings": [
          { "name": "KEY_VALUE_STORE", "class_name": "KeyValueStore" },
          { "name": "REALTIME_HUB", "class_name": "RealtimeHub" }
        ]
      }
    },
    "prod": {
      "name": "tearleads-platform-api-prod",
      // deployApi.sh fills this from the tier's Terraform hyperdrive_id output.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "HYPERDRIVE_ID_prod" }],
      "vars": {
        "API_REQUEST_COST_LOG": "true",
        "API_SENTRY_ENVIRONMENT": "production",
        "BLOB_OBJECT_STORE": "s3",
        "BLOB_OBJECT_STORE_S3_BUCKET": "tearleads-blobs-prod",
        "BLOB_OBJECT_STORE_S3_FORCE_PATH_STYLE": "true",
        "BLOB_OBJECT_STORE_S3_REGION": "auto",
        "POSTGRES_COALESCE_WRITES": "true",
        "POSTGRES_POOL_MAX": "4",
        "POSTGRES_POOL_MAX_USES": "1",
        "POSTGRES_REQUEST_SCOPED": "true",
        "REALTIME_HUB_LOCATION_HINT": "enam"
      },
      "durable_objects": {
        "bindings": [
          { "name": "KEY_VALUE_STORE", "class_name": "KeyValueStore" },
          { "name": "REALTIME_HUB", "class_name": "RealtimeHub" }
        ]
      }
    }
  }
}
