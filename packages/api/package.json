{
  "name": "@tearleads/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/buildApiExecutable.ts && bun scripts/buildBlobGcExecutable.ts && bun scripts/buildStripeSeatSyncExecutable.ts",
    "db:generate": "bun run --cwd ../api-shared db:generate",
    "db:generate:sqlite": "bun run --cwd ../api-shared db:generate:sqlite",
    "db:migrate": "bun run --cwd ../api-cli migrate",
    "dev": "bun --hot src/index.ts",
    "dev:postgres": "API_DATABASE=postgres bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun scripts/testAllDatabases.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@tearleads/api-shared": "workspace:*",
    "@tearleads/crypto": "workspace:*",
    "@tearleads/diagnostics": "workspace:*",
    "@tearleads/encoding": "workspace:*",
    "@tearleads/loro": "workspace:*",
    "@tearleads/validators": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "redis": "6.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tearleads/api-client": "workspace:*",
    "@tearleads/bob-and-alice": "workspace:*",
    "@tearleads/client-sdk": "workspace:*",
    "@tearleads/test-utils": "workspace:*",
    "@types/bun": "catalog:"
  }
}
