{
  "name": "@symcrypt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/buildApiExecutable.ts && bun scripts/buildBlobGcExecutable.ts && bun scripts/buildStripeSeatSyncExecutable.ts",
    "db:generate": "bun run --cwd ../api-shared db:generate",
    "db:generate:sqlite": "bun run --cwd ../api-shared db:generate:sqlite",
    "db:migrate": "bun run --cwd ../api-cli migrate",
    "dev": "bun --hot src/index.ts",
    "dev:postgres": "API_DATABASE=postgres bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun scripts/testAllDatabases.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1049.0",
    "@symcrypt/api-shared": "workspace:*",
    "@symcrypt/crypto": "workspace:*",
    "@symcrypt/encoding": "workspace:*",
    "@symcrypt/loro": "workspace:*",
    "@symcrypt/validators": "workspace:*",
    "drizzle-orm": "0.45.1",
    "hono": "4.7.11",
    "redis": "5.11.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@symcrypt/bob-and-alice": "workspace:*",
    "@symcrypt/client-sdk": "workspace:*",
    "@symcrypt/test-utils": "workspace:*",
    "@types/bun": "catalog:"
  }
}
