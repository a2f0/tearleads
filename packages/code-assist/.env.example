# --- Review config (CLI + server) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
# CODE_ASSIST_MODEL=deepseek-v4-flash        # or deepseek-v4-pro for higher quality
# CODE_ASSIST_BASE_URL=https://api.deepseek.com
# CODE_ASSIST_SEVERITY_THRESHOLD=medium      # low | medium | high | critical
# CODE_ASSIST_MAX_COMMENTS=25
# CODE_ASSIST_BOT_HANDLE=@tearleads-code-assist
# CODE_ASSIST_IGNORE_PATTERNS=**/*.lock,**/dist/**,**/build/**,**/.turbo/**,**/*.tsbuildinfo

# --- Webhook server only ---
# CODE_ASSIST_GITHUB_APP_ID=123456
# CODE_ASSIST_GITHUB_PRIVATE_KEY_PATH=/etc/code-assist/app.pem
# CODE_ASSIST_GITHUB_WEBHOOK_SECRET=change-me
# CODE_ASSIST_HOST=127.0.0.1
# CODE_ASSIST_PORT=3939
