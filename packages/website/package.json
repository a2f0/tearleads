{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "images": "sh scripts/buildWebImages.sh",
    "screenshots": "bun scripts/buildScreenshots.ts",
    "predev": "sh scripts/buildWebImages.sh && bun scripts/buildScreenshots.ts",
    "dev": "astro dev",
    "prebuild": "sh scripts/buildWebImages.sh && bun scripts/buildScreenshots.ts",
    "build": "astro build",
    "preview": "astro preview",
    "test": "bun test src",
    "deploy:assets": "wrangler deploy",
    "destroy:assets": "wrangler delete"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@phosphor-icons/react": "2.1.10",
    "@tearleads/ui": "workspace:*",
    "astro": "7.3.1",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "wrangler": "4.123.0"
  }
}
