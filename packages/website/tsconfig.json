{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["bun"],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": false,
    "outDir": "dist"
  },
  "include": [".astro/types.d.ts", "astro.config.ts", "src", "scripts"],
  "exclude": ["dist"]
}
