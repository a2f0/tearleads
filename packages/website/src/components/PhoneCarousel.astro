---
import { publicDir } from "astro:config/server";
import {
  findScreenshot,
  projectScreens,
  screenInfo,
  screenshotPath,
} from "@a2f0/agent-tool/screenshots/manifest";
import {
  SCREENSHOT_MANIFEST_URL,
  SCREENSHOTS_BASE_PATH,
} from "../screenshotPages";
import { loadScreenshotManifest } from "../screenshots";
import "@a2f0/agent-tool/screenshots/gallery.css";
import "../styles/screenshots.css";

/**
 * Home hero: every phone capture, in device frames, in agent-tool's looping
 * <screenshot-carousel>. The slides rendered here are the static page (no
 * JavaScript, crawlers, and the first paint) and use the element's own markup
 * and classes, so upgrading it swaps them without moving the layout. Only the
 * first phone, the hero's likely largest paint, loads eagerly and at high
 * priority. Without a phone capture (CI and test builds stage an empty
 * manifest) the row renders nothing, so the hero must read well without it.
 */
const manifest = await loadScreenshotManifest(publicDir);
const slides = projectScreens(manifest, "mobile").flatMap((name) => {
  const light =
    findScreenshot(manifest, "mobile", "light", name) ??
    findScreenshot(manifest, "mobile", "dark", name);
  if (!light) return [];
  const dark = findScreenshot(manifest, "mobile", "dark", name);
  const screen = screenInfo(manifest, name);
  return [
    {
      name,
      light,
      dark: dark === light ? undefined : dark,
      label: screen.label,
      alt: screen.alt ?? `${screen.label}, phone screenshot`,
    },
  ];
});
---

{slides.length > 0 && (
  <div class="phone-carousel">
    <screenshot-carousel
      manifest={SCREENSHOT_MANIFEST_URL}
      project="mobile"
      link-base={SCREENSHOTS_BASE_PATH}
      label="Tearleads on a phone"
    >
      <div class="shots-carousel" role="region" aria-label="Tearleads on a phone" data-frame="phone">
        <div class="shots-carousel-track" tabindex="0">
          <ul class="shots-carousel-list" role="list">
            {slides.map((slide, index) => (
              <li class="shots-carousel-slide">
                <figure>
                  <a class="shots-device" href={screenshotPath(SCREENSHOTS_BASE_PATH, "mobile", slide.name)}>
                    <picture>
                      {slide.dark && (
                        <source
                          media="(prefers-color-scheme: dark)"
                          srcset={slide.dark.src}
                          width={slide.dark.width}
                          height={slide.dark.height}
                        />
                      )}
                      <img
                        src={slide.light.src}
                        alt={slide.alt}
                        width={slide.light.width}
                        height={slide.light.height}
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : "auto"}
                        decoding="async"
                      />
                    </picture>
                  </a>
                  <figcaption>{slide.label}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </screenshot-carousel>
    <a class="site-link phone-carousel-all" href={screenshotPath(SCREENSHOTS_BASE_PATH, "mobile", slides[0]?.name ?? "")}>
      All screenshots<span aria-hidden="true"> →</span>
    </a>
  </div>
)}

<script>
  import { defineScreenshotElements } from "@a2f0/agent-tool/screenshots/gallery";

  defineScreenshotElements();
</script>
