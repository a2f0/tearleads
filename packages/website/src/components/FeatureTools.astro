---
import { AddressBookIcon } from "@phosphor-icons/react/dist/ssr/AddressBook";
import { FolderIcon } from "@phosphor-icons/react/dist/ssr/Folder";
import { NoteIcon } from "@phosphor-icons/react/dist/ssr/Note";

const features = [
  {
    icon: NoteIcon,
    title: "Notes that keep the context",
    description:
      "Capture an idea, write up a meeting, or keep a running reference. Attach the files and images that belong with your words.",
    items: [
      "Simple text editing",
      "File attachments and image previews",
      "Notes organized in containers",
    ],
  },
  {
    icon: AddressBookIcon,
    title: "A place for your people",
    description:
      "Keep names, nicknames, and profile photos together. Add a Tearleads user ID to connect a contact with their identity.",
    items: [
      "Create and edit contact profiles",
      "Custom profile photos",
      "Import Tearleads contacts by user ID",
    ],
  },
  {
    icon: FolderIcon,
    title: "Files with a home",
    description:
      "Use Explorer to put documents and files into nested containers. Browse the same workspace that your notes and contacts live in.",
    items: [
      "Nested containers",
      "File import and downloads",
      "Trash for removed items",
    ],
  },
];
---

<section class="product-section" id="everyday-tools" aria-labelledby="tools-title">
  <p class="product-eyebrow">The everyday essentials</p>
  <h2 id="tools-title">Keep related things together.</h2>
  <p class="product-section-lede">
    Three focused tools, one workspace. Move from a note to a contact to a file
    without leaving Tearleads.
  </p>
  <div class="feature-tools-grid">
    {features.map(({ icon: Icon, ...feature }) => (
      <article class="feature-tool">
        <span class="feature-icon"><Icon size={26} weight="regular" aria-hidden="true" /></span>
        <h3>{feature.title}</h3>
        <p>{feature.description}</p>
        <ul role="list">
          {feature.items.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
