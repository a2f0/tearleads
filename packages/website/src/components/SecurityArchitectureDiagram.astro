---
/**
 * Fig. 1 on /security: the client and service boundaries drawn as two app
 * windows. Solid frame: plaintext is available after unlock. Dashed frame: the
 * service stores and delivers encrypted records. The caption states both, so
 * the meaning never rests on the border style alone.
 */
const localSteps = [
  {
    title: "Unlock the local keyring",
    body: "A host wrapping key protects the account root key. An optional PIN adds another layer.",
  },
  {
    title: "Derive separate local keys",
    body: "One key each for the database, the local file store, and the saved identity.",
  },
  {
    title: "Keep local storage encrypted",
    body: "The app reads and writes through the encrypted database and file store.",
  },
];

const serviceRecords = [
  {
    term: "Encrypted payloads",
    body: "Document updates, files, and encrypted metadata.",
  },
  {
    term: "Wrapped keys",
    body: "Encrypted key envelopes that authorized clients can open.",
  },
  {
    term: "Signed access records",
    body: "Signed policies, grants, and content-write headers.",
  },
];
---

<figure class="security-figure" aria-labelledby="architecture-caption">
  <div class="security-boundaries">
    <div class="security-zone security-zone--device">
      <div class="security-zone-bar">
        <h3>Your device</h3>
        <span class="security-zone-label">Client boundary</span>
      </div>
      <div class="security-zone-body">
        <p class="security-zone-intro">Keys are unwrapped and content is decrypted here.</p>
        <ol class="security-local-flow" role="list">
          {localSteps.map((step, index) => (
            <li>
              <span class="security-step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h4>{step.title}</h4>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="security-zone-note">The unlocked app can read plaintext.</p>
      </div>
    </div>

    <div class="security-bridge">
      <span class="security-bridge-label">Encrypted sync</span>
      <svg viewBox="0 0 64 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M2 7h58m-6-5 6 5-6 5M62 17H4m6-5-6 5 6 5" stroke="currentColor" />
      </svg>
    </div>

    <div class="security-zone security-zone--service">
      <div class="security-zone-bar">
        <h3>Sync and storage</h3>
        <span class="security-zone-label">Service boundary</span>
      </div>
      <div class="security-zone-body">
        <p class="security-zone-intro">The API stores and delivers encrypted records.</p>
        <dl class="security-service-records">
          {serviceRecords.map((record) => (
            <div>
              <dt>{record.term}</dt>
              <dd>{record.body}</dd>
            </div>
          ))}
        </dl>
        <p class="security-zone-note">The service holds no plaintext content keys.</p>
      </div>
    </div>
  </div>
  <figcaption id="architecture-caption">
    <span class="security-figure-label">Fig. 1</span> Local storage and synced content use separate key layers. Sync exchanges
    encrypted records and access metadata, not the local database. Solid frame:
    plaintext is available after unlock. Dashed frame: the service stores and
    delivers encrypted records.
  </figcaption>
</figure>
