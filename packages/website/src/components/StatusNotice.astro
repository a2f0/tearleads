---
import { releaseNotice } from "../config";

/**
 * The release notice (Home hero, the screenshot gallery, and the Features,
 * Pricing, and Linux install headers: every page that shows phone captures,
 * which leave out the in-app test banner, plus the pages that sell or install
 * the app).
 * Renders nothing when `releaseNotice` in src/config.ts is null.
 */
---

{releaseNotice !== null && (
  <p class="site-status" role="note">
    <strong class="site-status-badge">Early access.</strong>
    <span>{releaseNotice}</span>
  </p>
)}
