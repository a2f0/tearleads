---
import { ArrowsClockwiseIcon } from "@phosphor-icons/react/dist/ssr/ArrowsClockwise";
import { FingerprintIcon } from "@phosphor-icons/react/dist/ssr/Fingerprint";
import { LockKeyIcon } from "@phosphor-icons/react/dist/ssr/LockKey";
import { ShieldCheckIcon } from "@phosphor-icons/react/dist/ssr/ShieldCheck";
import { securitySummary } from "../securitySummary";
import SectionHeader from "./SectionHeader.astro";

/**
 * Home: the security highlights, one card per protection; the rows and their
 * sources live in src/securitySummary.ts, and each card links the /security
 * section that states its assumptions and scope. The algorithm sentence
 * follows docs/cipher-suites.md, scoped to the keying protocol.
 */
const icons: Record<string, typeof LockKeyIcon> = {
  content: LockKeyIcon,
  sharing: ShieldCheckIcon,
  "removing-access": ArrowsClockwiseIcon,
  "your-device": FingerprintIcon,
};
const rows = securitySummary.map((row) => {
  const icon = icons[row.id];
  if (!icon) throw new Error(`No icon for security summary row ${row.id}`);
  return { row, Icon: icon };
});
---

<section
  class="site-section"
  id="security-summary"
  aria-labelledby="security-summary-title"
>
  <SectionHeader
    titleId="security-summary-title"
    title="Private by design"
    lede="Your content is encrypted before it leaves your device, and access is backed by signatures the app checks itself."
  >
    <a slot="action" class="site-link" href="/security">
      How the security model works<span aria-hidden="true"> →</span>
    </a>
  </SectionHeader>
  <ul class="home-security" role="list">
    {rows.map(({ row, Icon }) => (
      <li class="home-security-card">
        <span class="home-cell-icon" aria-hidden="true">
          <Icon size={22} focusable="false" />
        </span>
        <h3 class="home-security-title">{row.title}</h3>
        <p>{row.protection}</p>
        <a class="site-link" href={row.href}>
          Details<span class="visually-hidden">: {row.title}</span><span
            aria-hidden="true"> →</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="home-security-algorithms">
    <span class="home-security-badge">Post-quantum</span> Public-key
    operations in the Tearleads keying protocol use <span
      class="site-mono">ML-KEM-1024</span> for key delivery and <span
      class="site-mono">ML-DSA-87</span> for signatures (NIST FIPS 203 and
    204). Synced document and file contents are encrypted with <span
      class="site-mono">AES-256-GCM</span>.
  </p>
</section>
