---
import { appUrl } from "../config";

/**
 * Home's closing band: one line on the charcoal chrome, with one primary
 * action. .site-chrome-band (components.css) inverts the button and focus ring
 * for both color schemes.
 */
---

<section class="home-closing site-chrome-band" aria-labelledby="closing-title">
  <div class="home-closing-copy">
    <h2 id="closing-title" class="home-closing-title">Free on your device.</h2>
    <p class="home-closing-text">
      Open Tearleads in your browser, or install it on macOS or Linux.
    </p>
  </div>
  <div class="site-actions home-closing-actions">
    <a class="site-button site-button--primary" href={appUrl}>Open web app</a>
  </div>
</section>
