---
import LegalContact from "../components/LegalContact.astro";
import { legalDetails, shouldShowLegalDocument } from "../legal";
import Layout from "./Layout.astro";
import "../styles/product.css";
import "../styles/legal.css";

interface Props {
  readonly title: string;
  readonly description: string;
  readonly lede: string;
  readonly sections: readonly { readonly id: string; readonly label: string }[];
}

const { title, description, lede, sections } = Astro.props;
const showDocument = shouldShowLegalDocument({
  isDraft: legalDetails.isDraft,
  isDevelopment: import.meta.env.DEV && import.meta.env.MODE === "development",
  environment: import.meta.env.PUBLIC_ENVIRONMENT,
});
const pathname = Astro.url.pathname.replace(/\/$/, "");
const relatedPages = [
  { href: "/privacy-policy", label: "Privacy Policy" },
  { href: "/terms-of-service", label: "Terms of Service" },
  { href: "/security", label: "Security architecture" },
];
---

<Layout
  title={`${title} | Tearleads`}
  description={showDocument ? description : `${title} publication status and legal contact for Tearleads, LLC.`}
  noIndex={legalDetails.isDraft}
>
  <main class="website-main product-page legal-page">
    <article class="section" aria-labelledby="page-title">
      <header class="legal-header">
        <p class="product-eyebrow">Trust &amp; transparency</p>
        <h1 id="page-title">{title}</h1>
        <p class="section-lede">{showDocument ? lede : "This document is being prepared for publication and is not yet in effect."}</p>
        {showDocument && (
          <p class="legal-meta">
            {legalDetails.isDraft ? "Draft updated" : "Effective"}
            <time datetime={legalDetails.updatedAt}>{legalDetails.updatedLabel}</time>
            <span aria-hidden="true">·</span>
            {legalDetails.operator}
          </p>
        )}
      </header>

      <nav class="legal-related" aria-label="Legal and security documents">
        {relatedPages.map(({ href, label }) => (
          <a href={href} aria-current={pathname === href ? "page" : undefined}>{label}</a>
        ))}
      </nav>

      {showDocument ? (
        <Fragment>
          {legalDetails.isDraft && (
            <aside class="legal-draft" aria-label="Document status">
              <strong>Review draft · Not yet effective</strong>
              <p>Prepared for review. This document has not yet been adopted as the service’s policy.</p>
            </aside>
          )}

          <aside class="legal-summary" aria-label="At a glance">
            <p class="product-eyebrow">At a glance</p>
            <slot name="summary" />
            <p class="legal-summary-note">A quick guide. The full details follow below.</p>
          </aside>

          <div class="legal-reading-layout">
            <nav class="legal-contents" aria-labelledby="contents-title">
              <p id="contents-title">On this page</p>
              <ol>
                {sections.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}
              </ol>
            </nav>
            <div class="legal-copy">
              <slot />
              <a class="legal-back-to-top" href="#page-title">Back to top <span aria-hidden="true">↑</span></a>
            </div>
          </div>
        </Fragment>
      ) : (
        <div class="legal-copy">
          <p>For privacy questions or legal inquiries, please contact us:</p>
          <LegalContact />
        </div>
      )}
    </article>
  </main>
</Layout>
