---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="How it works | SymCrypt"
  description="How SymCrypt works: a local-first workspace that stays fast and offline, then syncs and shares on your terms."
>
  <main class="website-main">
    <section class="section" aria-labelledby="page-title">
      <h1 id="page-title">How it works</h1>
      <p class="section-lede">
        Everything lives locally on your device first, so the app is fast
        and works offline. When you're ready, sync keeps your workspaces up
        to date everywhere, and sharing lets you bring others in.
      </p>
    </section>
  </main>
</Layout>
