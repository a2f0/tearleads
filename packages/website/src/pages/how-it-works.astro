---
import { SiteFrame } from "../components/SiteFrame";
import { appUrl, isStaging } from "../config";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="How Tearleads works: a local-first workspace that stays fast and offline, then syncs and shares on your terms."
    />
    <title>How it works | Tearleads</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {isStaging && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <SiteFrame appUrl={appUrl}>
      <main class="website-main">
        <article class="section" aria-labelledby="page-title">
          <h1 id="page-title">How it works</h1>
          <p class="section-lede">
            Everything lives locally on your device first, so the app is fast
            and works offline. When you're ready, sync keeps your workspaces up
            to date everywhere, and sharing lets you bring others in.
          </p>
        </article>
      </main>
    </SiteFrame>
  </body>
</html>
