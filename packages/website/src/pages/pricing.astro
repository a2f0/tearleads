---
import { PricingTiers } from "../components/PricingTiers";
import { appUrl } from "../config";
import Layout from "../layouts/Layout.astro";
import { createPricingTiers, syncMemberCapacities } from "../pricing";
import "../styles/product.css";
import "../styles/pricing.css";

const pricingTiers = createPricingTiers(appUrl);
---

<Layout
  title="Pricing | Tearleads"
  description="Start with Tearleads free forever on your device. Add encrypted sync with Solo, or share an organization with a Team plan. Compare monthly USD prices and member capacity."
>
  <main class="website-main">
    <article class="section product-page pricing-page" aria-labelledby="page-title">
      <header>
        <p class="product-eyebrow">Pricing / Find your fit</p>
        <h1 id="page-title">Start local. Grow together.</h1>
        <p class="section-lede">
          Your local workspace is free forever. Add encrypted sync for yourself,
          or choose a team plan to share an organization with others.
        </p>
      </header>
      <PricingTiers tiers={pricingTiers} />
      <p class="pricing-note">
        Prices shown are monthly USD list prices. Each paid price covers one
        organization with the member capacity shown; it is not a per-member price.
        Confirm the final price and any applicable taxes in checkout. App store
        pricing may vary by region.
      </p>

      <section class="product-section" aria-labelledby="choose-plan-title">
        <p class="product-eyebrow">Getting started</p>
        <h2 id="choose-plan-title">Choose your plan inside Tearleads.</h2>
        <p class="product-section-lede">
          Open Org Manager, select your organization, and go to Billing to see
          eligible plans and subscribe. Your organization's administrators manage
          its subscription and member capacity.
        </p>
        <div class="pricing-details">
          <div>
            <h3>What is an organization member?</h3>
            <p>
              A member is a user in your organization's active roster. Plans cover
              a fixed capacity of {syncMemberCapacities} members, including admins.
              Your devices do not each consume another member seat.
            </p>
          </div>
          <div>
            <h3>How do I manage a subscription?</h3>
            <p>
              Use Billing in Org Manager to manage your plan. Web subscriptions
              can also be managed through the Stripe email login portal;
              subscriptions purchased through an app store are managed there.
            </p>
            <a class="product-text-link" href="/manage-subscription">Manage a web subscription <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <aside class="product-cta" aria-labelledby="pricing-cta-title">
        <div>
          <p class="product-eyebrow">Take a closer look</p>
          <h2 id="pricing-cta-title">Get to know your workspace.</h2>
          <p>Explore the tools, or see how encryption and verified sharing protect your content.</p>
        </div>
        <div class="product-actions">
          <a class="product-button" href="/features">Explore features</a>
          <a class="product-text-link" href="/security">Security architecture</a>
        </div>
      </aside>
    </article>
  </main>
</Layout>
