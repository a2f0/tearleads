---
import { PricingTiers } from "../components/PricingTiers";
import { SiteFrame } from "../components/SiteFrame";
import { appUrl, isStaging } from "../config";
import "../styles/global.css";

const pricingTiers = [
  {
    name: "Free Forever",
    price: "$0",
    description:
      "A local-first workspace for your notes, contacts, and files. Yours to keep, at no cost, forever.",
  },
  {
    name: "Sync",
    price: "Coming soon",
    description:
      "Keep every workspace in sync across all of your devices, encrypted end to end.",
  },
  {
    name: "Sharing",
    price: "Coming soon",
    description:
      "Share containers and collaborate with others, with fine-grained control over who sees what.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Tearleads pricing: a free-forever local-first workspace, with sync and sharing coming soon."
    />
    <title>Pricing | Tearleads</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {isStaging && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <SiteFrame appUrl={appUrl}>
      <main class="website-main">
        <section class="section" aria-labelledby="page-title">
          <h1 id="page-title">Pricing</h1>
          <PricingTiers tiers={pricingTiers} />
        </section>
      </main>
    </SiteFrame>
  </body>
</html>
