---
import { getLargestSyncBillingTier } from "@tearleads/validators/billing";
import PageHeader from "../components/PageHeader.astro";
import PricingTiers from "../components/PricingTiers.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatusNotice from "../components/StatusNotice.astro";
import { appUrl } from "../config";
import Layout from "../layouts/Layout.astro";
import { createPricingTiers, syncMemberCapacities } from "../pricing";
import "../styles/pricing.css";

const pricingTiers = createPricingTiers();
// Trials and web checkout both top out at the largest plan's capacity
// (packages/api organizationSeatCapacity.ts, workflows/billing/stripeCheckout.ts).
// The personal organization starts its trial at registration
// (workflows/auth/registration.ts); other organizations start local, and the
// Billing view offers the trial only then.
const largestCapacity = getLargestSyncBillingTier().seatLimit;
---

<Layout
  title="Pricing | Tearleads"
  description="Tearleads is free on your device. Paid plans add end-to-end encrypted sync for one organization, and Team plans add sharing. Monthly USD prices."
>
  <div class="site-page">
    <PageHeader
      title="Pricing"
      lede="Tearleads is free on your device. Paid plans add end-to-end encrypted sync for one organization, priced by member capacity rather than per member."
    >
      <StatusNotice />
    </PageHeader>

    <section class="pricing-plans-section" aria-labelledby="plans-title">
      <h2 id="plans-title" class="visually-hidden">Plans</h2>
      <PricingTiers tiers={pricingTiers} />
      <p class="pricing-note">
        Monthly prices in US dollars. Each paid plan covers one organization at
        the capacity shown, one flat price for the whole roster. Checkout shows
        the final price, including any taxes.
      </p>
      <div class="site-cta">
        <p>
          Subscribe from the web app: open Org Manager, choose your
          organization, and go to Billing.
        </p>
        <div class="site-actions">
          <a class="site-button site-button--primary" href={appUrl}>Open web app</a>
        </div>
      </div>
    </section>

    <section class="site-section pricing-billing" id="billing" aria-labelledby="billing-title">
      <SectionHeader titleId="billing-title" title="How billing works" />
      <dl class="site-spec site-spec--wide-key">
        <div>
          <dt>Who manages billing</dt>
          <dd>Organization admins manage the subscription.</dd>
        </div>
        <div>
          <dt>Free trial</dt>
          <dd>
            Your personal organization starts a 7-day free sync trial when the
            app first registers your identity. For any other organization, an
            admin can start one from the same Billing view. A trial covers
            up to {largestCapacity} members.
          </dd>
        </div>
        <div>
          <dt>Who counts as a member</dt>
          <dd>
            Everyone on your organization's active roster, admins included.
            Devices are never counted. Plans cover
            {" "}{syncMemberCapacities} members, which the app's Billing view
            calls seats.
          </dd>
        </div>
        <div>
          <dt>Which plan you get</dt>
          <dd>
            When you subscribe on the web, checkout picks the smallest plan that
            covers your roster, for rosters of up to {largestCapacity} members.
          </dd>
        </div>
        <div>
          <dt>Seats</dt>
          <dd>
            Each plan has a fixed number of seats. When every seat is taken, a
            new member starts syncing as soon as a seat frees up.
          </dd>
        </div>
        <div>
          <dt>Manage or cancel</dt>
          <dd>
            <p>
              Admins can cancel in Org Manager → Billing, and sync continues
              until the paid period ends. You can also manage a web subscription
              through Stripe with just your billing email.
            </p>
            <a class="site-link" href="/manage-subscription/">Manage a web subscription<span aria-hidden="true"> →</span></a>
          </dd>
        </div>
        <div>
          <dt>When a plan ends</dt>
          <dd>
            Everything on your devices stays yours. Sync becomes read-only, and
            synced data stays available to download during a grace period;
            after that, the service deletes the organization's synced documents
            and files.
          </dd>
        </div>
      </dl>
    </section>
  </div>
</Layout>
