---
import { ScreenshotsBrowser } from "../components/ScreenshotsBrowser";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Screenshots | Tearleads"
  description="Browse Tearleads screenshots: windowed and mobile layouts in light and dark themes."
>
  <main class="website-main">
    <section class="section" aria-labelledby="page-title">
      <h1 id="page-title">Screenshots</h1>
      <p class="section-lede">
        A look at Tearleads across windowed and mobile layouts, in light and
        dark themes.
      </p>
      <ScreenshotsBrowser client:load />
    </section>
  </main>
</Layout>
