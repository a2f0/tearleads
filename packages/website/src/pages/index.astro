---
import DownloadList from "../components/DownloadList.astro";
import HomeClosing from "../components/HomeClosing.astro";
import HomePricing from "../components/HomePricing.astro";
import HomeProduct from "../components/HomeProduct.astro";
import HomeSecuritySummary from "../components/HomeSecuritySummary.astro";
import HomeSteps from "../components/HomeSteps.astro";
import HomeZero from "../components/HomeZero.astro";
import PageHeader from "../components/PageHeader.astro";
import Screenshot from "../components/Screenshot.astro";
import StatusNotice from "../components/StatusNotice.astro";
import { appUrl } from "../config";
import Layout from "../layouts/Layout.astro";
import { startingSyncPrice } from "../pricing";
import "../styles/home.css";
import "../styles/homeSections.css";
import { tagline, taglineLines } from "../tagline";

const metaItems = [
  "Free on your device",
  `Sync from ${startingSyncPrice}/month`,
  "macOS",
  "Linux",
  "Web",
];
---

<Layout
  title={`Tearleads | ${tagline}`}
  description="Notes, contacts, and files encrypted on your device. No signup, email, or password. Free locally; paid plans add end-to-end encrypted sync. macOS, Linux, web."
>
  <div class="site-page home">
    <section class="home-hero" aria-labelledby="page-title">
      <PageHeader
        display
        title={tagline}
        lede="Notes, contacts, and files, encrypted on your device before they sync. No email, no password, no signup form: open Tearleads and start working."
      >
        <Fragment slot="title">
          {taglineLines.map((line, index) => (
            <>
              {index > 0 && " "}
              <span class="home-hero-line">{line}</span>
            </>
          ))}
        </Fragment>
        <div class="site-actions">
          <a class="site-button site-button--primary" href={appUrl}>Open web app</a>
          <a class="site-button site-button--secondary" href="#download">
            Download for desktop
          </a>
        </div>
        <ul class="site-meta home-meta home-dot-list" role="list">
          {metaItems.map((item) => <li>{item}</li>)}
        </ul>
        <StatusNotice />
      </PageHeader>
      <Screenshot
        name="explorer"
        crop="2880 / 860"
        phoneCrop="1170 / 1580"
        tabletZoom
        priority
        caption="Explorer"
        alt="Tearleads Explorer listing Contacts and Trash folders, a driver's license record, and three notes, with each item's type."
      />
    </section>

    <HomeZero />
    <HomeProduct />
    <HomeSteps />
    <HomeSecuritySummary />
    <HomePricing />
    <DownloadList />
    <HomeClosing />
  </div>
</Layout>
