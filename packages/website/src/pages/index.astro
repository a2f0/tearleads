---
import { isStaging } from "../config";
import Layout from "../layouts/Layout.astro";
import { resolveLinuxDownloads } from "../linuxDownloads";
import { resolveMacosDownloads } from "../macosDownloads";

const [macos, linux] = await Promise.all([
  resolveMacosDownloads(isStaging),
  resolveLinuxDownloads(isStaging),
]);
---

<Layout
  title="Tearleads"
  description="Tearleads is a local-first workspace for your notes, contacts, and files."
>
  <main class="website-main">
    <section class="intro" aria-labelledby="page-title">
      <h1 id="page-title">Tearleads</h1>
      <p class="lede">
        Keep your notes, contacts, and files in one place — local-first,
        synced across your devices, and shared on your terms.
      </p>
      <div class="desktop-downloads">
        <div class="desktop-download">
          <a class="download-button" href={macos.installerUrl}>
            {isStaging ? "Download macOS preview" : "Download for macOS"}
          </a>
          <p>For Macs with Apple silicon.</p>
          <a class="download-checksum" href={macos.checksumUrl} aria-label="SHA-256 checksum for macOS">
            SHA-256 checksum
          </a>
        </div>
        <div class="desktop-download">
          <a class="download-button" href={linux.installerUrl}>
            {isStaging ? "Download Linux preview" : "Download for Linux"}
          </a>
          <p>For Linux x64 (Intel / AMD).</p>
          <a class="download-checksum" href={linux.checksumUrl} aria-label="SHA-256 checksum for Linux">
            SHA-256 checksum
          </a>
          <p>
            <a class="download-checksum" href="/downloads/linux">Installation instructions</a>
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .desktop-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    margin-top: 32px;
  }

  .download-button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 24px;
    border-radius: 6px;
    background: #244c37;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .download-button:hover {
    background: #183526;
  }

  .download-button:focus-visible {
    outline: 3px solid #244c37;
    outline-offset: 4px;
  }

  .desktop-download p {
    margin: 12px 0 4px;
    color: #45534e;
  }

  .download-checksum {
    color: #244c37;
    font-size: 0.875rem;
  }
</style>
