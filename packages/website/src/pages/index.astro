---
import { isStaging } from "../config";
import Layout from "../layouts/Layout.astro";
import { resolveMacosDownloads } from "../macosDownloads";

const { installerUrl: macosDownloadUrl, checksumUrl } =
  await resolveMacosDownloads(isStaging);
---

<Layout
  title="Tearleads"
  description="Tearleads is a local-first workspace for your notes, contacts, and files."
>
  <main class="website-main">
    <section class="intro" aria-labelledby="page-title">
      <h1 id="page-title">Tearleads</h1>
      <p class="lede">
        Keep your notes, contacts, and files in one place — local-first,
        synced across your devices, and shared on your terms.
      </p>
      <div class="desktop-download">
        <a class="download-button" href={macosDownloadUrl}>
          {isStaging ? "Download macOS preview" : "Download for macOS"}
        </a>
        <p>For Macs with Apple silicon.</p>
        <a class="download-checksum" href={checksumUrl}>
          SHA-256 checksum
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .desktop-download {
    margin-top: 32px;
  }

  .download-button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 24px;
    border-radius: 6px;
    background: #244c37;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .download-button:hover {
    background: #183526;
  }

  .download-button:focus-visible {
    outline: 3px solid #244c37;
    outline-offset: 4px;
  }

  .desktop-download p {
    margin: 12px 0 4px;
    color: #45534e;
  }

  .download-checksum {
    color: #244c37;
    font-size: 0.875rem;
  }
</style>
