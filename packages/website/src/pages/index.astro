---
import { PricingTiers } from "../components/PricingTiers";
import { SiteFrame } from "../components/SiteFrame";
import "../styles/global.css";

const isStaging = import.meta.env.PUBLIC_ENVIRONMENT === "staging";
const appUrl = isStaging
  ? "https://app.tearleads.de"
  : "https://app.tearleads.com";

const pricingTiers = [
  {
    name: "Free Forever",
    price: "$0",
    description:
      "A local-first workspace for your notes, contacts, and files. Yours to keep, at no cost, forever.",
  },
  {
    name: "Sync",
    price: "Coming soon",
    description:
      "Keep every workspace in sync across all of your devices, encrypted end to end.",
  },
  {
    name: "Sharing",
    price: "Coming soon",
    description:
      "Share containers and collaborate with others, with fine-grained control over who sees what.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Tearleads is a local-first workspace for your notes, contacts, and files."
    />
    <title>Tearleads</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {isStaging && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <SiteFrame appUrl={appUrl}>
      <main class="website-main">
        <section class="intro" aria-labelledby="page-title">
          <p class="eyebrow">Local-first workspace</p>
          <h1 id="page-title">Tearleads</h1>
          <p class="lede">
            Keep your notes, contacts, and files in one place — local-first,
            synced across your devices, and shared on your terms.
          </p>
        </section>

        <section
          id="how-it-works"
          class="section"
          aria-labelledby="how-it-works-title"
        >
          <h2 id="how-it-works-title">How it works</h2>
          <p class="section-lede">
            Everything lives locally on your device first, so the app is fast
            and works offline. When you're ready, sync keeps your workspaces up
            to date everywhere, and sharing lets you bring others in.
          </p>
        </section>

        <section id="pricing" class="section" aria-labelledby="pricing-title">
          <h2 id="pricing-title">Pricing</h2>
          <PricingTiers tiers={pricingTiers} />
        </section>

        <section id="features" class="section" aria-labelledby="features-title">
          <h2 id="features-title">Features</h2>
          <p class="section-lede">
            A window-based workspace with notes, contacts, and file storage,
            built to stay fast, private, and yours.
          </p>
        </section>
      </main>
    </SiteFrame>
  </body>
</html>
