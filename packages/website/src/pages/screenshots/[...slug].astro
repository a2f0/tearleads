---
import { publicDir } from "astro:config/server";
import PageHeader from "../../components/PageHeader.astro";
import { ScreenshotsBrowser } from "../../components/ScreenshotsBrowser";
import {
  projectLabel,
  screenLabel,
  screenshotRoutes,
} from "../../components/screenshotsManifest";
import Layout from "../../layouts/Layout.astro";
import { loadScreenshotManifest } from "../../screenshots";

interface Props {
  initialPlatform?: string;
  initialScreen?: string;
}

// One route per captured platform/screen pair, plus the /screenshots index.
// Light and dark captures share a route. With no captures only the index
// route exists.
export async function getStaticPaths() {
  return screenshotRoutes(await loadScreenshotManifest(publicDir));
}

const { initialPlatform, initialScreen } = Astro.props;
const title =
  initialScreen && initialPlatform
    ? `${screenLabel(initialScreen)}, ${projectLabel(initialPlatform).toLowerCase()} screenshot | Tearleads`
    : "Screenshots | Tearleads";
---

<Layout
  title={title}
  description="Tearleads screens in desktop, tablet, and phone layouts, in light and dark themes."
>
  <div class="site-page">
    <PageHeader
      title="Screenshots"
      lede="Every captured screen in desktop, phone, and tablet layouts, in light and dark themes."
    />
    <ScreenshotsBrowser client:load initialScreen={initialScreen} initialPlatform={initialPlatform} />
    <noscript>
      <p class="site-note screenshots-noscript">The screenshot gallery needs JavaScript.</p>
    </noscript>
  </div>
</Layout>
