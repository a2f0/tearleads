---
import { publicDir } from "astro:config/server";
import { readFile } from "node:fs/promises";
import { ScreenshotsBrowser } from "../../components/ScreenshotsBrowser";
import {
  projectLabel,
  type ScreenshotManifest,
  screenshotRoutes,
  titleCase,
} from "../../components/screenshotsManifest";
import Layout from "../../layouts/Layout.astro";

interface Props {
  initialPlatform?: string;
  initialScreen?: string;
}

// One route per captured platform/screen pair, plus the /screenshots index.
// Deduplicate light/dark captures so each pair builds only once. The manifest
// is staged by
// scripts/buildScreenshots.ts on predev/prebuild, before Astro runs; with no
// captures only the index route exists.
export async function getStaticPaths() {
  const manifestUrl = new URL("screenshot-gallery/manifest.json", publicDir);
  const manifest = JSON.parse(
    await readFile(manifestUrl, "utf8"),
  ) as ScreenshotManifest;
  return screenshotRoutes(manifest);
}

const { initialPlatform, initialScreen } = Astro.props;
const screenTitle = initialScreen
  ? `${titleCase(initialScreen)}${initialPlatform ? ` (${projectLabel(initialPlatform)})` : ""} Screenshot | Tearleads`
  : "Screenshots | Tearleads";
---

<Layout
  title={screenTitle}
  description="Browse Tearleads screenshots in Windowed, Mobile, and Tablet layouts with light and dark themes."
>
  <main class="website-main">
    <section class="section" aria-labelledby="page-title">
      <h1 id="page-title">Screenshots</h1>
      <p class="section-lede">
        A look at Tearleads across Windowed, Mobile, and Tablet layouts, in light
        and dark themes.
      </p>
      <ScreenshotsBrowser client:load initialScreen={initialScreen} initialPlatform={initialPlatform} />
    </section>
  </main>
</Layout>
