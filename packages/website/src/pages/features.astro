---
import PageHeader from "../components/PageHeader.astro";
import Screenshot from "../components/Screenshot.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatusNotice from "../components/StatusNotice.astro";
import { appUrl } from "../config";
import Layout from "../layouts/Layout.astro";
import { startingSyncPrice } from "../pricing";
import "../styles/features.css";

// Tool names match the app's launcher labels (packages/app/src/mini-apps/registry.ts).
const tools = [
  {
    name: "Explorer",
    text: "Organize notes, contacts, files, and structured records such as driver's licenses and passports in nested folders. Import files, download them again, and move removed items to Trash.",
  },
  {
    name: "Notes",
    text: "Write plain-text notes and attach files, with image previews.",
  },
  {
    name: "Contacts",
    text: "Keep names, nicknames, and profile photos. Import another Tearleads user by user ID to link the contact to their identity.",
  },
  {
    name: "Identity Manager",
    text: "Create and switch identities, back up your recovery phrase, set a PIN lock, and review active sessions.",
  },
  {
    name: "Backup / Restore",
    text: "Export a password-protected backup of your local data and the file contents stored on the device, and restore it from the file.",
  },
  {
    name: "Org Manager",
    text: "Manage your organization's roster, groups, access grants, usage, and billing.",
  },
] as const;
---

<Layout
  title="Features | Tearleads"
  description="What Tearleads does: notes, contacts, files, and records in nested folders, offline editing, password-protected backups, end-to-end encrypted sync, and sharing."
>
  <div class="site-page features-page">
    <PageHeader
      title="Features"
      lede="Notes, contacts, files, and records in one folder tree, stored encrypted on your device and editable offline. Sync comes with paid plans, and sharing with Team plans."
    >
      <StatusNotice />
    </PageHeader>

    <section class="site-section" id="tools" aria-labelledby="tools-title">
      <div class="features-split">
        <SectionHeader
          titleId="tools-title"
          title="Tools"
          lede="On desktop, each tool opens in its own window. On phones and tablets, tools open one at a time, with back navigation. Light and dark themes are included."
        />
        <dl class="site-spec">
          {tools.map((tool) => (
            <div>
              <dt>{tool.name}</dt>
              <dd>{tool.text}</dd>
            </div>
          ))}
        </dl>
      </div>
      <Screenshot
        name="explorer"
        crop="2880 / 860"
        phoneCrop="1170 / 1580"
        tabletZoom
        caption="Explorer, root folder"
        alt="Explorer showing the root folder: Contacts and Trash folders, a driver's license record, and three notes, each with its type."
      />
    </section>

    <section class="site-section" id="on-your-device" aria-labelledby="device-title">
      <div class="features-split">
        <SectionHeader
          titleId="device-title"
          title="On your device"
          lede="Content stored on your device is encrypted, and you can read and edit it offline. Edits save locally and sync when you reconnect; sharing and other remote actions need a connection."
        />
        <div class="features-split-body">
          <dl class="site-spec">
            <div>
              <dt>Encrypted storage</dt>
              <dd>
                The app reads and writes through an encrypted database and file
                store. How strongly the local key is protected depends on the
                platform: <a href="/security#local-storage">Local storage and PIN protection</a>.
              </dd>
            </div>
            <div>
              <dt>Backups</dt>
              <dd>
                Keep a backup file somewhere you control. It includes your local
                data and the file contents stored on the device.
              </dd>
            </div>
          </dl>
          <div class="site-note" role="note">
            <strong class="site-note-label">Recovery phrase.</strong> Your 24-word
            recovery phrase, or its QR code, restores your identity for anyone who
            has it. Keep it private.
          </div>
        </div>
      </div>
    </section>

    <section class="site-section" id="sync-and-sharing" aria-labelledby="sharing-title">
      <div class="features-split">
        <SectionHeader
          titleId="sharing-title"
          title="Sync and sharing"
          lede="After a 7-day free trial, sync needs a paid plan, and sharing with other people needs a Team plan."
        />
        <div class="features-split-body">
          <div class="features-pair">
            <div>
              <h3>Sync</h3>
              <p>
                Changes you make are queued on your device and sent when you're
                online, and changes from your other devices are merged in.
                Document and file contents are encrypted before they reach the
                service.
              </p>
            </div>
            <div>
              <h3>Sharing</h3>
              <p>
                Share a folder with users and groups in your organization, with
                read, write, or admin access. To share with someone, first add
                them to your organization's roster; each roster member counts
                toward your plan's capacity.
              </p>
            </div>
          </div>
          <a class="site-link features-action" href="/security#verified-sharing">
            How sharing is verified<span aria-hidden="true"> →</span>
          </a>
        </div>
      </div>
      <Screenshot
        name="org-manager-grants"
        crop="2880 / 700"
        phoneCrop="1170 / 1200"
        caption="Org Manager, Grants"
        alt="Org Manager's Grants view: the Members group has read access to Organization Metadata, and the Admins group has admin access to the root folder."
      />
    </section>

    <section
      class="site-section features-split features-authorship"
      id="document-authorship"
      aria-labelledby="authorship-title"
    >
      <SectionHeader
        titleId="authorship-title"
        title="Authorship"
        lede="Document Info in Explorer lists a note's contributors with their edit counts and highlights which contributor wrote each character. The same view shows the note's links, attachments, and security details."
      />
      <Screenshot
        name="note-blame"
        crop="1440 / 1280"
        phoneCrop="1170 / 1740"
        size="narrow"
        caption="Document Info, authorship"
        alt="Document Info for a note: edit and character counts for two contributors, and the note's text highlighted in each author's color."
      />
    </section>

    <div class="site-cta">
      <p>Free on your device. Sync from {startingSyncPrice}/month.</p>
      <div class="site-actions">
        <a class="site-button site-button--primary" href={appUrl}>Open web app</a>
        <a class="site-link" href="/pricing">Compare plans<span aria-hidden="true"> →</span></a>
      </div>
    </div>
  </div>
</Layout>
