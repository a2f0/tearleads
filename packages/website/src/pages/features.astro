---
import { SiteFrame } from "../components/SiteFrame";
import { appUrl, isStaging } from "../config";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Tearleads features: a window-based workspace with notes, contacts, and file storage, built to stay fast, private, and yours."
    />
    <title>Features | Tearleads</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {isStaging && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <SiteFrame appUrl={appUrl}>
      <main class="website-main">
        <section class="section" aria-labelledby="page-title">
          <h1 id="page-title">Features</h1>
          <p class="section-lede">
            A window-based workspace with notes, contacts, and file storage,
            built to stay fast, private, and yours.
          </p>
        </section>
      </main>
    </SiteFrame>
  </body>
</html>
