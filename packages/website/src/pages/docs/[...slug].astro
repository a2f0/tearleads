---
import { getCollection, render } from "astro:content";
import PageHeader from "../../components/PageHeader.astro";
import ReadingLayout from "../../components/ReadingLayout.astro";
import Layout from "../../layouts/Layout.astro";
import {
  docForSlug,
  docPath,
  sourceUrl,
  type TechnicalDoc,
} from "../../technicalDocs";
import "../../styles/docs.css";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const doc: TechnicalDoc = docForSlug(entry.id);
// docLinksPlugin replaces the document's own h1; the header renders doc.title.
const { Content, headings } = await render(entry);
const title = doc.title;
// A topic page sits under its document in the breadcrumb.
const parent = doc.parent === undefined ? undefined : docForSlug(doc.parent);
const contents = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({ href: `#${heading.slug}`, label: heading.text }));
---

<Layout title={`${title} | Tearleads`} description={doc.summary}>
  <article class="site-page docs-page" aria-labelledby="page-title">
    <PageHeader title={title} lede={doc.summary}>
      <nav slot="before" class="site-breadcrumb" aria-label="Breadcrumb">
        <ol role="list">
          <li><a href="/security/">Security</a></li>
          <li><a href="/docs/">Technical documents</a></li>
          {parent && <li><a href={docPath(parent)}>{parent.title}</a></li>}
          <li aria-current="page">{doc.title}</li>
        </ol>
      </nav>
      <p class="docs-source">
        Published from{" "}
        <a class="site-link" href={sourceUrl(doc.source)}>
          {doc.source}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (GitHub)</span>
        </a>
      </p>
    </PageHeader>
    {contents.length > 2 ? (
      <ReadingLayout class="site-prose docs-prose" contents={contents} wide>
        <Content />
      </ReadingLayout>
    ) : (
      <div class="site-prose docs-prose">
        <Content />
      </div>
    )}
  </article>
</Layout>
