---
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
import {
  apiReferenceListing,
  docPath,
  technicalDocs,
} from "../../technicalDocs";
import "../../styles/docs.css";
---

<Layout
  title="Documentation | Tearleads"
  description="The Tearleads security guarantees, keying design, protocol specification, cipher suites, protocol models, limits, glossary, and API reference."
>
  <div class="site-page docs-page">
    <PageHeader title="Documentation">
      <nav slot="before" class="site-breadcrumb" aria-label="Breadcrumb">
        <ol role="list">
          <li><a href="/security/">Security</a></li>
          <li aria-current="page">Documentation</li>
        </ol>
      </nav>
    </PageHeader>

    <dl class="site-spec site-spec--wide-key docs-index">
      {technicalDocs.map((doc) => (
        <div>
          <dt><a class="site-link" href={docPath(doc)}>{doc.title}</a></dt>
          <dd>
            {doc.summary}
            <span class="docs-index-path">{doc.source}</span>
          </dd>
        </div>
      ))}
      <div>
        <dt><a class="site-link" href={apiReferenceListing.path}>{apiReferenceListing.title}</a></dt>
        <dd>
          {apiReferenceListing.summary}
          <span class="docs-index-path">{apiReferenceListing.source}</span>
        </dd>
      </div>
    </dl>
  </div>
</Layout>
