{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  // Custom domains are owned by the independent Terraform website stacks.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html (src/pages/404.astro) with status 404.
    "not_found_handling": "404-page"
  },
  "env": {
    "staging": { "name": "tearleads-website-staging" },
    "prod": { "name": "tearleads-website-prod" }
  }
}
