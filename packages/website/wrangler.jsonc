{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  // Custom domains are owned by the independent Terraform website stacks.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "env": {
    "staging": { "name": "tearleads-website-staging" },
    "prod": { "name": "tearleads-website-prod" }
  }
}
