{
  "name": "app-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client-sdk": "bun run --cwd ../client-sdk build",
    "pree2e": "bun run build:client-sdk",
    "e2e": "env -u NO_COLOR -u FORCE_COLOR playwright test",
    "test:e2e": "bun run e2e",
    "predev": "bun run build:client-sdk",
    "dev": "sh ../../scripts/withBuildInfoEnv.sh bun --hot src/servers/devServer.ts",
    "prescreenshots": "bun run build:client-sdk && bun run --cwd ../.. screenshots:seed",
    "screenshots": "env -u NO_COLOR -u FORCE_COLOR playwright test --config=playwright.screenshots.config.ts",
    "prebuild": "bun run build:client-sdk",
    "build": "export NODE_ENV=production && rm -rf dist && sh ../../scripts/withBuildInfoEnv.sh bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --env='BUN_PUBLIC_*' --public-path=/ && bun scripts/buildStaticAssets.ts && sh scripts/buildWebImages.sh && bun scripts/buildServiceWorker.ts",
    "prestart": "bun run build:client-sdk",
    "start": "sh ../../scripts/withBuildInfoEnv.sh bun src/servers/devServer.ts",
    "test": "bun test scripts --max-concurrency=1"
  },
  "dependencies": {
    "@stripe/stripe-js": "8.0.0",
    "@tearleads/client-sdk": "workspace:*",
    "@tearleads/sqlite-worker": "workspace:*",
    "app": "workspace:*",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bun": "catalog:",
    "@types/react-dom": "catalog:react"
  }
}
