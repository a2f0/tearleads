{
  "name": "app-web",
  "version": "0.1.24",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "sentry:cli": "sentry-cli",
    "build:client-sdk": "bun run --cwd ../client-sdk build",
    "pree2e": "bun run build:client-sdk",
    "e2e": "env -u NO_COLOR -u FORCE_COLOR playwright test",
    "test:e2e": "bun run e2e",
    "predev": "bun run build:client-sdk",
    "dev": "sh ../../scripts/lib/withBuildInfoEnv.sh bun --hot src/servers/devServer.ts",
    "prescreenshots": "bun screenshots/sharedStore.ts && bun run --cwd ../.. screenshots:seed",
    "screenshots": "env -u NO_COLOR -u FORCE_COLOR playwright test --config=playwright.screenshots.config.ts",
    "prebuild": "bun run build:client-sdk",
    "build": "export NODE_ENV=production && rm -rf dist && sh ../../scripts/lib/withBuildInfoEnv.sh bun scripts/buildApp.ts && bun scripts/buildStaticAssets.ts && agent-tool --repo ../.. images build app-web && bun scripts/injectFaviconLinks.ts && bun scripts/injectTierMeta.ts && bun scripts/buildServiceWorker.ts",
    "prestart": "bun run build:client-sdk",
    "start": "sh ../../scripts/lib/withBuildInfoEnv.sh bun src/servers/devServer.ts",
    "test": "bun test scripts --max-concurrency=1",
    "deploy:app": "wrangler deploy --config wrangler.app.jsonc",
    "deploy:demo": "wrangler deploy --config wrangler.demo.jsonc",
    "destroy:app": "wrangler delete --config wrangler.app.jsonc",
    "destroy:demo": "wrangler delete --config wrangler.demo.jsonc"
  },
  "dependencies": {
    "@a2f0/ct-client": "0.1.5",
    "@stripe/stripe-js": "10.1.0",
    "@tearleads/client-sdk": "workspace:*",
    "@tearleads/diagnostics": "workspace:*",
    "app": "workspace:*",
    "pdfjs-dist": "6.4.299",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@a2f0/continuity": "catalog:",
    "@playwright/test": "1.64.1",
    "@sentry/browser": "11.8.0",
    "@sentry/cli": "3.8.1",
    "@tearleads/loro": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react-dom": "catalog:react",
    "wrangler": "4.123.0"
  }
}
