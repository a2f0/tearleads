{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "e2e": {
      "description": "The signed-in specs run the API from its source against an in-memory store (playwright.config.ts), so an API change must miss this cache.",
      "dependsOn": ["$TURBO_EXTENDS$", "@tearleads/api#runtime-sources"],
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "APP_WEB_SIGNED_IN_API_PORT",
        "APP_WEB_SIGNED_IN_PORT"
      ],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/scripts/lib/withBuildInfoEnv.sh",
        "$TURBO_ROOT$/scripts/lib/packageVersions.ts",
        "$TURBO_ROOT$/packages/website/src/clickTracking.ts",
        "$TURBO_ROOT$/packages/app/test/container-view-seed/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/scripts/lib/withBuildInfoEnv.sh",
        "$TURBO_ROOT$/scripts/lib/packageVersions.ts"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/scripts/lib/withBuildInfoEnv.sh",
        "$TURBO_ROOT$/scripts/lib/packageVersions.ts",
        "$TURBO_ROOT$/assets/brand/**",
        "$TURBO_ROOT$/agent-tool.json"
      ]
    }
  }
}
