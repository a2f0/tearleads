{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  // Custom domains are owned by the tier's edge Terraform stack.
  "assets": {
    "directory": "./dist-app",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": { "name": "tearleads-app-staging" },
    "prod": { "name": "tearleads-app-prod" }
  }
}
