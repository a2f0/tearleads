{
  "name": "app-electrobun",
  "version": "0.0.13",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sh scripts/runElectronbun.sh dev",
    "dev:reset": "sh scripts/runElectronbun.sh dev --reset",
    "dev:watch": "sh scripts/runElectronbun.sh dev --watch",
    "build": "sh scripts/buildElectrobun.sh",
    "build:dev": "sh scripts/buildElectrobun.sh --env dev",
    "build:staging": "sh ../../scripts/release/buildMacosStagingRelease.sh",
    "build:release": "sh ../../scripts/release/buildMacosRelease.sh",
    "build:linux": "sh ../../scripts/release/buildLinuxRelease.sh",
    "build:linux:staging": "sh ../../scripts/release/buildLinuxStagingRelease.sh",
    "build:linux:release": "sh ../../scripts/release/buildLinuxRelease.sh",
    "upload:linux": "sh ../../scripts/release/uploadLinuxRelease.sh",
    "upload:linux:staging": "sh ../../scripts/release/uploadLinuxStagingRelease.sh",
    "upload:linux:release": "sh ../../scripts/release/uploadLinuxRelease.sh",
    "upload:staging": "sh ../../scripts/release/uploadMacosStagingRelease.sh",
    "upload:release": "sh ../../scripts/release/uploadMacosRelease.sh",
    "test": "bun test scripts src --pass-with-no-tests",
    "test:release-packaging": "bun scripts/testReleasePackaging.ts",
    "test:linux-persistence": "sh scripts/testLinuxPersistence.sh",
    "test:linux-release": "bash scripts/testLinuxRelease.sh",
    "test:windows-persistence": "bun scripts/testWindowsPersistence.ts",
    "prepare:devkit": "bun --bun run electrobun sync",
    "build:windows": "bash ../../scripts/release/windowsRelease.sh build production",
    "build:windows:staging": "bash ../../scripts/release/windowsRelease.sh build staging",
    "download:windows": "bash ../../scripts/release/windowsRelease.sh download production",
    "download:windows:staging": "bash ../../scripts/release/windowsRelease.sh download staging",
    "upload:windows": "bash ../../scripts/release/windowsRelease.sh upload production",
    "upload:windows:staging": "bash ../../scripts/release/windowsRelease.sh upload staging"
  },
  "dependencies": {
    "@tearleads/client-sdk": "workspace:*",
    "@tearleads/diagnostics": "workspace:*",
    "app": "workspace:*",
    "electrobun": "2.0.4",
    "pdfjs-dist": "6.4.299",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@sentry/cli": "3.8.1",
    "@tearleads/loro": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react-dom": "catalog:react"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
