{
  "name": "app-electrobun",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "sh scripts/runElectronbun.sh dev",
    "dev:reset": "sh scripts/runElectronbun.sh dev --reset",
    "dev:watch": "sh scripts/runElectronbun.sh dev --watch",
    "build": "sh scripts/buildElectrobun.sh",
    "build:dev": "sh scripts/buildElectrobun.sh --env dev",
    "build:staging": "sh ../../scripts/buildMacosStagingRelease.sh",
    "build:release": "sh ../../scripts/buildMacosRelease.sh",
    "build:linux": "sh ../../scripts/buildLinuxRelease.sh",
    "build:linux:staging": "sh ../../scripts/buildLinuxStagingRelease.sh",
    "build:linux:release": "sh ../../scripts/buildLinuxRelease.sh",
    "upload:linux": "sh ../../scripts/uploadLinuxRelease.sh",
    "upload:linux:staging": "sh ../../scripts/uploadLinuxStagingRelease.sh",
    "upload:linux:release": "sh ../../scripts/uploadLinuxRelease.sh",
    "upload:staging": "sh ../../scripts/uploadMacosStagingRelease.sh",
    "upload:release": "sh ../../scripts/uploadMacosRelease.sh",
    "test": "bun test scripts src --pass-with-no-tests",
    "test:release-packaging": "bun scripts/testReleasePackaging.ts",
    "test:linux-persistence": "sh scripts/testLinuxPersistence.sh",
    "test:linux-release": "bash scripts/testLinuxRelease.sh",
    "test:windows-persistence": "bun scripts/testWindowsPersistence.ts",
    "prepare:devkit": "bun --bun run electrobun sync"
  },
  "dependencies": {
    "@tearleads/client-sdk": "workspace:*",
    "@tearleads/diagnostics": "workspace:*",
    "@tearleads/sqlite-worker": "workspace:*",
    "app": "workspace:*",
    "electrobun": "2.0.1",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@sentry/cli": "3.7.0",
    "@tearleads/loro": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react-dom": "catalog:react",
    "pdfjs-dist": "6.3.289"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
