{
  "extends": ["../../tsconfig.base.json", "./.hutch/devkit/tsconfig.json"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "ignoreDeprecations": "6.0",
    "composite": false,
    "jsx": "react-jsx",
    // Electrobun currently exports .ts sources that fail this stricter check.
    "exactOptionalPropertyTypes": false,
    // Electrobun currently has vendor code paths without explicit returns.
    "noImplicitReturns": false
  },
  "include": ["src", "scripts", "electrobun.config.ts"],
  "exclude": ["node_modules", "../../node_modules"]
}
