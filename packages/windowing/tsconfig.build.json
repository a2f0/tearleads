{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "incremental": false,
    "inlineSources": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.testUtils.ts",
    "src/**/*.testUtils.tsx",
    "src/**/testUtils.ts",
    "src/**/testUtils.tsx"
  ]
}
