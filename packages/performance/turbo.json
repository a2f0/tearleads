{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/app/src/stores/systemContainers.ts",
        "$TURBO_ROOT$/packages/api/wrangler.jsonc"
