{
  "name": "tearleads",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.3",
  "catalog": {
    "@a2f0/continuity": "github:a2f0/continuity#ccec49fd27cc7084c1b8ab3cc4ea34c270ed5149",
    "@types/bun": "1.4.3",
    "@types/invariant": "2.2.37",
    "ajv": "8.20.0",
    "invariant": "2.2.4",
    "loro-crdt": "1.16.4",
    "openapi-typescript": "7.13.0",
    "zod": "4.6.7"
  },
  "catalogs": {
    "react": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    },
    "testing": {
      "@happy-dom/global-registrator": "21.0.4",
      "@testing-library/react": "16.3.3",
      "fast-check": "4.10.2",
      "msw": "2.15.0"
    }
  },
  "scripts": {
    "agent:logs": "agent-tool logs",
    "agent:run": "agent-tool run",
    "agent-tool": "agent-tool",
    "agents:check": "bun run agent-tool skills check && bun run agent-tool permissions check",
    "agents:sync": "bun run agent-tool skills install --apply && bun run agent-tool permissions install --apply",
    "build:packages": "bun run build:runtime && bun run --cwd packages/app-electrobun prepare:devkit",
    "build:runtime": "turbo run build --filter=@tearleads/sqlite-instance --filter=@tearleads/client-sdk",
    "build:website": "bun run screenshots && bun run --cwd packages/website build",
    "check": "bun scripts/testing/runVerification.ts full",
    "check:affected": "bun scripts/testing/runVerification.ts affected",
    "check:package": "bun scripts/testing/runVerification.ts package",
    "check:fast": "sh scripts/checks/checkFast.sh",
    "check:protocol-models": "sh scripts/checks/checkProtocolModels.sh",
    "check:protocol-traces": "bun scripts/protocol/generateBaselineDominanceTraces.ts --check",
    "check:protocol-proofs": "bun scripts/protocol/generateTransparencyVectors.ts --check",
    "check:protocol-projection": "bun scripts/protocol/checkRestartProbeProjection.ts",
    "check:protocol-negative-controls": "bun scripts/protocol/checkProtocolNegativeControls.ts",
    "check:no-brick-projection": "bun scripts/protocol/checkNoBrickProjection.ts",
    "lint:formal-maps": "bun scripts/protocol/lintFormalAbstractionMaps.ts",
    "clean:local-caches": "bun scripts/dev/cleanLocalCaches.ts",
    "clean:local-caches:deps": "bun scripts/dev/cleanLocalCaches.ts --include-node-modules",
    "clean:local-caches:dry-run": "bun scripts/dev/cleanLocalCaches.ts --dry-run",
    "generate:openapi": "bun run --cwd packages/validators generate:openapi",
    "generate:protocol-traces": "bun scripts/protocol/generateBaselineDominanceTraces.ts",
    "generate:protocol-proof-vectors": "bun scripts/protocol/generateTransparencyVectors.ts",
    "lint:architecture": "bun scripts/architecture/lintArchitecture.ts",
    "lint:binary-files": "agent-tool checks binaries",
    "lint:biome": "biome check --error-on-warnings && bun scripts/checks/checkRuntimeScopedMemoDependencies.ts && bun run lint:biome:promises",
    "lint:biome:promises": "bun run test:biome:promises && biome lint --config-path biome.promises.jsonc --only=lint/nursery/noFloatingPromises --error-on-warnings packages",
    "lint:branch-name": "agent-tool branch check",
    "lint:canonical-ordering": "bun scripts/checks/lintCanonicalOrdering.ts",
    "lint:commit-msg": "sh scripts/git/hooks/commit-msg",
    "lint:files": "ls-lint",
    "lint:infrastructure-parity": "bash scripts/checks/checkInfrastructureParity.sh",
    "lint:knip:all": "knip",
    "lint:knip:dependencies": "knip --dependencies",
    "lint:knip:exports": "knip --exports",
    "lint:knip:files": "knip --files",
    "lint:knip:production": "knip --production",
    "lint:markdown": "git ls-files -z -- '*.md' | xargs -0 bun --bun x markdownlint-cli2",
    "lint:markdown:fix": "git ls-files -z -- '*.md' | xargs -0 bun --bun x markdownlint-cli2 --fix",
    "lint:openapi": "bun run --cwd packages/validators lint:openapi",
    "lint:openapi:compatibility": "sh scripts/checks/checkOpenApiCompatibility.sh",
    "lint:package-assertions": "bun scripts/checks/lintPackageAssertions.ts",
    "lint:ruby": "sh scripts/checks/checkRuby.sh",
    "lint:scripts": "bun scripts/checks/lintScripts.ts",
    "lint:skill-placeholders": "bun scripts/checks/lintSkillPlaceholders.ts",
    "lint:source-shape": "bun scripts/checks/lintSourceShape.ts",
    "publish:npm": "bash scripts/release/publishNpmPackage.sh",
    "publish:npm:dry-run": "bash scripts/release/publishNpmPackage.sh --dry-run",
    "report:dependencies": "bun scripts/architecture/reportDependencyGraph.ts",
    "report:dependencies:archi": "bun scripts/architecture/reportDependencyGraph.ts --format archi",
    "report:dependencies:json": "bun scripts/architecture/reportDependencyGraph.ts --format json",
    "report:dependencies:mermaid": "bun scripts/architecture/reportDependencyGraph.ts --format mermaid",
    "report:lines": "bun scripts/checks/countLines.ts",
    "screenshots": "bun run --filter=app-web screenshots",
    "screenshots:seed": "turbo run build --filter=@tearleads/sqlite-instance --filter=@tearleads/client-sdk && bun packages/app/test/screenshot-seed/buildScreenshotSeed.ts",
    "scope": "bun scripts/dev/scope.ts",
    "scope:register": "bun scripts/dev/scope.ts register",
    "test:bun": "bun run build:packages && bun run --filter='*' --sequential test",
    "test:openapi:compatibility": "sh scripts/checks/testOpenApiCompatibility.sh",
    "test:postgres-concurrency": "sh scripts/checks/testPostgresConcurrency.sh",
    "test:native-android-ci": "sh scripts/checks/testNativePurchaseBridge.sh android",
    "test:native-ios-ci": "sh scripts/checks/testNativePurchaseBridge.sh ios",
    "test:windows-ci": "bun run --cwd packages/app-electrobun prepare:devkit && bun test ./packages/app-electrobun/scripts/cefMonitorExpression.test.ts ./packages/app-electrobun/scripts/verifyWindowsArtifacts.test.ts ./packages/app-electrobun/scripts/windowsSourceMapStaging.test.ts ./packages/app-electrobun/scripts/sentryReleaseSource.test.ts && pwsh -NoProfile -NonInteractive -File packages/app-electrobun/scripts/testWindowsPortConflict.ps1",
    "test:turso-concurrency": "sh scripts/checks/testTursoConcurrency.sh",
    "test:protocol-conformance": "sh scripts/checks/testProtocolConformance.sh",
    "test:protocol-models": "sh scripts/checks/testProtocolModels.sh",
    "test:scope": "bun test scripts/dev/scope/*.test.ts scripts/dev/scope/judge",
    "test:scope:native": "bun test scripts/dev/scope/native-tests",
    "test:static-analysis": "bun scripts/testing/testStaticAnalysis.ts",
    "test:architecture": "bun scripts/testing/testArchitecture.ts",
    "test:step-timings": "cd scripts/lib && bun test stepTimings.test.ts",
    "test:npm-publish": "cd scripts/release && bun test releasePlan.test.ts publishPolicy.test.ts publishNpmPackage.test.ts",
    "test:biome:promises": "bun scripts/testing/testBiomePromises.ts",
    "test:turbo": "bun run test:turbo:bun && bun run test:turbo:e2e",
    "test:turbo:affected": "bun run test:turbo:bun:affected && bun run test:turbo:e2e:affected",
    "test:turbo:bun": "bun scripts/testing/runVerifiedTurbo.ts test",
    "test:turbo:bun:affected": "bun scripts/testing/runVerifiedTurbo.ts test --affected",
    "test:turbo:e2e": "bun scripts/testing/runVerifiedTurbo.ts e2e --filter=app-web",
    "test:turbo:e2e:affected": "bun scripts/testing/runVerifiedTurbo.ts e2e --affected",
    "knip": "bun run lint:knip:all",
    "perf:provision": "bun run --cwd packages/performance provision",
    "test:knip:production": "bun scripts/testing/testKnipProduction.ts",
    "perf:database": "bun run --cwd packages/performance database"
  },
  "workspaces": [
    "packages/api",
    "packages/api-client",
    "packages/api-cli",
    "packages/api-shared",
    "packages/app",
    "packages/app-web",
    "packages/app-capacitor",
    "packages/app-electrobun",
    "packages/bob-and-alice",
    "packages/client-sdk",
    "packages/crypto",
    "packages/diagnostics",
    "packages/encoding",
    "packages/loro",
    "packages/performance",
    "packages/sqlite-instance",
    "packages/sqlite-worker",
    "packages/test-utils",
    "packages/ui",
    "packages/validators",
    "packages/website",
    "packages/windowing"
  ],
  "lint-staged": {
    "*.{css,html,js,json,jsonc,jsx,mjs,cjs,ts,tsx}": "biome check --fix --error-on-warnings",
    "*.md": "bun --bun x markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.28",
    "@azure/storage-blob": "12.30.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@ls-lint/ls-lint": "2.3.2",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@types/invariant": "catalog:",
    "dependency-cruiser": "18.7.0",
    "invariant": "catalog:",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "tar": "7.5.22",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "zod": "catalog:"
  },
  "overrides": {
    "miniflare@5.20260811.1-alpha": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  },
  "patchedDependencies": {
    "@capacitor/cli@8.5.3": "patches/@capacitor-cli-8.5.3-ios18.patch",
    "markdownlint@0.42.0": "patches/markdownlint@0.42.0.patch",
    "knip@6.42.1": "patches/knip@6.42.1.patch"
  }
}
