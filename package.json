{
  "name": "tearleads",
  "private": true,
  "packageManager": "bun@1.3.11",
  "catalog": {
    "@types/bun": "1.3.11",
    "@types/invariant": "2.2.37",
    "invariant": "2.2.4"
  },
  "catalogs": {
    "react": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    },
    "testing": {
      "@happy-dom/global-registrator": "20.8.4",
      "@testing-library/react": "16.3.2"
    }
  },
  "scripts": {
    "lint:files": "ls-lint",
    "lint:commit-msg": "commitlint --edit",
    "test:bun": "bun run --filter='*' --sequential test",
    "test:turbo": "bun run test:turbo:bun && bun run test:turbo:e2e",
    "test:turbo:affected": "bun run test:turbo:bun:affected && bun run test:turbo:e2e:affected",
    "test:turbo:bun": "turbo run test",
    "test:turbo:bun:affected": "turbo run test --affected",
    "test:turbo:e2e": "turbo run e2e --filter=app-web",
    "test:turbo:e2e:affected": "turbo run e2e --affected",
    "knip": "knip"
  },
  "workspaces": [
    "packages/api",
    "packages/api-client",
    "packages/app",
    "packages/app-web",
    "packages/app-electrobun",
    "packages/crypto",
    "packages/encoding",
    "packages/loro",
    "packages/sqlite-instance",
    "packages/sqlite-worker",
    "packages/test-utils",
    "packages/validators"
  ],
  "lint-staged": {
    "*.{css,html,js,json,jsonc,jsx,mjs,cjs,ts,tsx}": "biome check --fix --error-on-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@tearleads/api-client": "workspace:*",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.11",
    "app": "workspace:*",
    "knip": "6.0.6",
    "lint-staged": "16.4.0",
    "madge": "8.0.0",
    "turbo": "2.8.20",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@types/invariant": "catalog:",
    "invariant": "catalog:"
  }
}
