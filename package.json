{
  "name": "tearleads",
  "private": true,
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@types/bun": "1.4.1",
    "@types/invariant": "2.2.37",
    "ajv": "8.20.0",
    "invariant": "2.2.4",
    "loro-crdt": "1.16.0",
    "openapi-typescript": "7.13.0",
    "zod": "4.5.4"
  },
  "catalogs": {
    "react": {
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7"
    },
    "testing": {
      "@happy-dom/global-registrator": "20.14.0",
      "@testing-library/react": "16.3.3",
      "fast-check": "4.9.0",
      "msw": "2.15.0"
    }
  },
  "scripts": {
    "build:packages": "turbo run build --filter=@tearleads/sqlite-instance --filter=@tearleads/client-sdk && bun run --cwd packages/app-electrobun prepare:devkit",
    "check": "bun run build:packages && bun tsc --build --pretty false && bun run check:fast && bun run test:turbo",
    "check:affected": "bun run build:packages && bun tsc --build --pretty false && bun run check:fast && bun run test:turbo:affected",
    "check:fast": "sh scripts/checks/checkFast.sh",
    "check:protocol-models": "sh scripts/checks/checkProtocolModels.sh",
    "check:protocol-traces": "bun scripts/protocol/generateBaselineDominanceTraces.ts --check",
    "check:protocol-projection": "bun scripts/protocol/checkRestartProbeProjection.ts",
    "check:protocol-negative-controls": "bun scripts/protocol/checkProtocolNegativeControls.ts",
    "check:no-brick-projection": "bun scripts/protocol/checkNoBrickProjection.ts",
    "lint:formal-maps": "bun scripts/protocol/lintFormalAbstractionMaps.ts",
    "clean:local-caches": "bun scripts/cleanLocalCaches.ts",
    "clean:local-caches:deps": "bun scripts/cleanLocalCaches.ts --include-node-modules",
    "clean:local-caches:dry-run": "bun scripts/cleanLocalCaches.ts --dry-run",
    "generate:openapi": "bun run --cwd packages/validators generate:openapi",
    "generate:protocol-traces": "bun scripts/protocol/generateBaselineDominanceTraces.ts",
    "lint:ansible": "ansible-lint ansible/",
    "lint:architecture": "bun scripts/architecture/lintArchitecture.ts",
    "lint:binary-files": "sh scripts/checks/checkBinaryFiles.sh",
    "lint:biome": "biome check --error-on-warnings && bun scripts/checks/checkRuntimeScopedMemoDependencies.ts && bun run lint:biome:promises",
    "lint:biome:promises": "bun run test:biome:promises && biome lint --config-path biome.promises.jsonc --only=lint/nursery/noFloatingPromises --error-on-warnings packages",
    "lint:branch-name": "bun scripts/checks/lintBranchName.ts",
    "lint:canonical-ordering": "bun scripts/checks/lintCanonicalOrdering.ts",
    "lint:commit-msg": "sh -lc 'NPX=$(command -v npx); \"$NPX\" --yes --package @commitlint/cli --package @commitlint/config-conventional commitlint --config commitlint.config.mts --edit \"$1\"' --",
    "lint:files": "ls-lint",
    "lint:infrastructure-parity": "bash scripts/checks/checkInfrastructureParity.sh",
    "lint:knip:all": "knip",
    "lint:knip:dependencies": "knip --dependencies",
    "lint:knip:exports": "knip --exports",
    "lint:knip:files": "knip --files",
    "lint:knip:production": "knip --production",
    "lint:markdown": "git ls-files -z -- '*.md' | xargs -0 bun --bun x markdownlint-cli2",
    "lint:markdown:fix": "git ls-files -z -- '*.md' | xargs -0 bun --bun x markdownlint-cli2 --fix",
    "lint:openapi": "bun run --cwd packages/validators lint:openapi",
    "lint:openapi:compatibility": "sh scripts/checks/checkOpenApiCompatibility.sh",
    "lint:package-assertions": "bun scripts/checks/lintPackageAssertions.ts",
    "lint:ruby": "sh scripts/checks/checkRuby.sh",
    "lint:scripts": "bun scripts/checks/lintScripts.ts",
    "lint:skill-placeholders": "bun scripts/checks/lintSkillPlaceholders.ts",
    "lint:source-shape": "bun scripts/checks/lintSourceShape.ts",
    "report:dependencies": "bun scripts/architecture/reportDependencyGraph.ts",
    "report:dependencies:archi": "bun scripts/architecture/reportDependencyGraph.ts --format archi",
    "report:dependencies:json": "bun scripts/architecture/reportDependencyGraph.ts --format json",
    "report:dependencies:mermaid": "bun scripts/architecture/reportDependencyGraph.ts --format mermaid",
    "report:lines": "bun scripts/countLines.ts",
    "screenshots": "bun run --filter=app-web screenshots",
    "screenshots:seed": "bun packages/app/test/screenshot-seed/buildScreenshotSeed.ts",
    "test:bun": "bun run build:packages && bun run --filter='*' --sequential test",
    "test:openapi:compatibility": "sh scripts/checks/testOpenApiCompatibility.sh",
    "test:postgres-concurrency": "sh scripts/checks/testPostgresConcurrency.sh",
    "test:turso-concurrency": "sh scripts/checks/testTursoConcurrency.sh",
    "test:protocol-conformance": "sh scripts/checks/testProtocolConformance.sh",
    "test:protocol-models": "sh scripts/checks/testProtocolModels.sh",
    "test:static-analysis": "bun scripts/testing/testStaticAnalysis.ts",
    "test:architecture": "bun scripts/testing/testArchitecture.ts",
    "test:step-timings": "cd scripts/lib && bun test stepTimings.test.ts",
    "test:biome:promises": "bun scripts/testing/testBiomePromises.ts",
    "test:turbo": "bun run test:turbo:bun && bun run test:turbo:e2e",
    "test:turbo:affected": "bun run test:turbo:bun:affected && bun run test:turbo:e2e:affected",
    "test:turbo:bun": "turbo run test",
    "test:turbo:bun:affected": "turbo run test --affected",
    "test:turbo:e2e": "turbo run e2e --filter=app-web",
    "test:turbo:e2e:affected": "turbo run e2e --affected",
    "knip": "bun run lint:knip:all",
    "test:knip:production": "bun scripts/testing/testKnipProduction.ts"
  },
  "workspaces": [
    "packages/agent-tool",
    "packages/api",
    "packages/api-client",
    "packages/api-cli",
    "packages/api-shared",
    "packages/app",
    "packages/app-web",
    "packages/app-capacitor",
    "packages/app-electrobun",
    "packages/bob-and-alice",
    "packages/client-sdk",
    "packages/crypto",
    "packages/diagnostics",
    "packages/encoding",
    "packages/loro",
    "packages/sqlite-instance",
    "packages/sqlite-worker",
    "packages/test-utils",
    "packages/ui",
    "packages/validators",
    "packages/website"
  ],
  "lint-staged": {
    "*.{css,html,js,json,jsonc,jsx,mjs,cjs,ts,tsx}": "biome check --fix --error-on-warnings",
    "*.md": "bun --bun x markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@ls-lint/ls-lint": "2.3.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.1",
    "@types/invariant": "catalog:",
    "dependency-cruiser": "18.2.0",
    "invariant": "catalog:",
    "knip": "6.34.0",
    "lint-staged": "17.5.0",
    "markdownlint-cli2": "0.23.2",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@redocly/openapi-core@1.34.17": {
      "js-yaml": "4.3.2"
    },
    "markdownlint-cli2@0.23.2": {
      "smol-toml": "1.8.0"
    },
    "miniflare@5.20260811.1-alpha": {
      "sharp": "0.35.4"
    }
  },
  "patchedDependencies": {
    "@capacitor/cli@8.5.1": "patches/@capacitor-cli-8.5.1-ios18.patch",
    "knip@6.34.0": "patches/knip-6.34.0.patch"
  }
}
