{
  "name": "tearleads",
  "private": true,
  "packageManager": "bun@1.3.11",
  "catalog": {
    "@types/bun": "1.3.11",
    "@types/invariant": "2.2.37",
    "invariant": "2.2.4",
    "loro-crdt": "1.10.8"
  },
  "catalogs": {
    "react": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    },
    "testing": {
      "@happy-dom/global-registrator": "20.8.4",
      "@testing-library/react": "16.3.2",
      "msw": "2.12.14"
    }
  },
  "scripts": {
    "check": "bun tsc --build --pretty false && bun run check:fast && bun run test:turbo",
    "check:affected": "bun tsc --build --pretty false && bun run check:fast && bun run test:turbo:affected",
    "check:fast": "bun run lint:biome && bun run lint:package-assertions && bun run lint:knip:all && bun run lint:knip:production && bun run lint:architecture && bun run lint:files && bun run lint:source-shape && bun run lint:binary-files && bun run lint:ruby",
    "lint:ansible": "ansible-lint ansible/",
    "lint:architecture": "bun scripts/lintArchitecture.ts",
    "lint:binary-files": "sh scripts/checks/checkBinaryFiles.sh",
    "lint:biome": "biome check --error-on-warnings",
    "lint:branch-name": "bun scripts/lintBranchName.ts",
    "lint:commit-msg": "sh -lc 'NPX=$(command -v npx); \"$NPX\" --yes --package @commitlint/cli --package @commitlint/config-conventional commitlint --config commitlint.config.mts --edit \"$1\"' --",
    "lint:files": "ls-lint",
    "lint:file-limits": "sh scripts/checks/checkFileLimits.sh",
    "lint:knip:all": "knip",
    "lint:knip:dependencies": "knip --dependencies",
    "lint:knip:exports": "knip --exports",
    "lint:knip:files": "knip --files",
    "lint:knip:production": "knip --production",
    "lint:package-assertions": "bun scripts/lintPackageAssertions.ts",
    "lint:ruby": "sh scripts/checks/checkRuby.sh",
    "lint:scripts": "shellcheck --severity=info ansible/inventories/*.sh ansible/scripts/*.sh terraform/scripts/*.sh terraform/stacks/staging/server/scripts/*.sh terraform/stacks/prod/server/scripts/*.sh",
    "lint:source-shape": "bun scripts/lintSourceShape.ts",
    "report:dependencies": "bun scripts/reportDependencyGraph.ts",
    "report:dependencies:archi": "bun scripts/reportDependencyGraph.ts --format archi",
    "report:dependencies:json": "bun scripts/reportDependencyGraph.ts --format json",
    "report:dependencies:mermaid": "bun scripts/reportDependencyGraph.ts --format mermaid",
    "report:lines": "bun scripts/countLines.ts",
    "test:bun": "bun run --filter='@tearleads/sqlite-instance' build && bun run --filter='@tearleads/client-sdk' build && bun run --filter='*' --sequential test",
    "test:turbo": "bun run test:turbo:bun && bun run test:turbo:e2e",
    "test:turbo:affected": "bun run test:turbo:bun:affected && bun run test:turbo:e2e:affected",
    "test:turbo:bun": "turbo run test",
    "test:turbo:bun:affected": "turbo run test --affected",
    "test:turbo:e2e": "turbo run e2e --filter=app-web",
    "test:turbo:e2e:affected": "turbo run e2e --affected",
    "knip": "bun run lint:knip:all"
  },
  "workspaces": [
    "packages/api",
    "packages/api-client",
    "packages/api-cli",
    "packages/api-shared",
    "packages/app",
    "packages/app-web",
    "packages/app-capacitor",
    "packages/app-electrobun",
    "packages/bob-and-alice",
    "packages/client-sdk",
    "packages/code-assist",
    "packages/crypto",
    "packages/encoding",
    "packages/loro",
    "packages/sqlite-instance",
    "packages/sqlite-worker",
    "packages/test-utils",
    "packages/ui",
    "packages/validators",
    "packages/website"
  ],
  "lint-staged": {
    "*.{css,html,js,json,jsonc,jsx,mjs,cjs,ts,tsx}": "biome check --fix --error-on-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.11",
    "@types/invariant": "catalog:",
    "dependency-cruiser": "17.3.10",
    "invariant": "catalog:",
    "knip": "6.0.6",
    "lint-staged": "16.4.0",
    "turbo": "2.8.20",
    "typescript": "5.9.3"
  }
}
