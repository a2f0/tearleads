#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

cd "$REPO_ROOT"

echo "Linting branch name..."
bun run lint:branch-name

echo "Checking file names..."
bun run lint:files

echo "Checking for binary files..."
tmpfile=$(mktemp)
git diff --cached --numstat --diff-filter=ACM > "$tmpfile"
while IFS='	' read -r added deleted file; do
  if [ "$added" = "-" ] || [ "$deleted" = "-" ]; then
    echo "ERROR: Binary file detected: $file" >&2
    rm -f "$tmpfile"
    exit 1
  fi
done < "$tmpfile"
rm -f "$tmpfile"

bun run lint-staged
