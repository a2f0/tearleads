#!/bin/sh

set -e

echo "Checking for binary files..."
tmpfile=$(mktemp)
git diff --cached --name-only --diff-filter=ACM > "$tmpfile"
while IFS= read -r file; do
  if file "$file" | grep -qv text; then
    echo "ERROR: Binary file detected: $file" >&2
    rm -f "$tmpfile"
    exit 1
  fi
done < "$tmpfile"
rm -f "$tmpfile"

bun run lint-staged
