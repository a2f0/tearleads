#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

cd "$REPO_ROOT"

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  if git rev-parse --verify origin/main >/dev/null 2>&1; then
    commitlint_base_ref="origin/main"
  elif git rev-parse --verify main >/dev/null 2>&1; then
    commitlint_base_ref="main"
  else
    commitlint_base_ref=""
  fi

  if [ -n "$commitlint_base_ref" ]; then
    commitlint_from="$(git merge-base HEAD "$commitlint_base_ref")"
    commitlint_to="$(git rev-parse HEAD)"

    if [ "$commitlint_from" != "$commitlint_to" ]; then
      echo "Linting branch commit messages..."
      bunx commitlint --from "$commitlint_from" --to "$commitlint_to"
    fi
  fi
fi

echo "Checking file names..."
bun run lint:files

echo "Checking for binary files..."
tmpfile=$(mktemp)
git diff --cached --numstat --diff-filter=ACM > "$tmpfile"
while IFS='	' read -r added deleted file; do
  if [ "$added" = "-" ] || [ "$deleted" = "-" ]; then
    echo "ERROR: Binary file detected: $file" >&2
    rm -f "$tmpfile"
    exit 1
  fi
done < "$tmpfile"
rm -f "$tmpfile"

bun run lint-staged
