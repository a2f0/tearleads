#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

cd "$REPO_ROOT"

echo "Linting branch name..."
bun run lint:branch-name

echo "Checking file names..."
bun run lint:files

echo "Checking source shape..."
bun scripts/lintSourceShape.ts --staged

echo "Checking for binary files..."
"$REPO_ROOT/scripts/checks/checkBinaryFiles.sh" --staged

bun run lint-staged
