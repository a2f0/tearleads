#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

cd "$REPO_ROOT"

refs_file=$(mktemp)
trap 'rm -f "$refs_file"' EXIT
trap 'exit 1' HUP INT TERM

if [ -t 0 ]; then
  : >"$refs_file"
else
  cat >"$refs_file"
fi

echo "Linting branch name..."
bun run lint:branch-name

echo "Running shellcheck..."
bun run lint:scripts
bun run test:static-analysis

echo "Running terraform linting..."
"$REPO_ROOT/scripts/checks/checkTerraform.sh"

echo "Running TypeScript compiler..."
bun tsc --build --pretty false

echo "Running biome check..."
bun run lint:biome

echo "Running markdown linting..."
bun run lint:markdown

echo "Checking package type assertions..."
bun run lint:package-assertions

echo "Running knip..."
bun run lint:knip:all

echo "Running production knip..."
bun run lint:knip:production

echo "Checking dependency graph and architecture boundaries..."
bun run lint:architecture

echo "Checking file names..."
bun run lint:files

echo "Checking commit signatures and co-authors..."
zero_sha="0000000000000000000000000000000000000000"

while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    range="main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  "$REPO_ROOT/scripts/checks/checkCommitTrust.sh" --range "$range" </dev/null
done <"$refs_file"

echo "Checking source shape..."

while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    range="main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  bun scripts/lintSourceShape.ts --range "$range" </dev/null
done <"$refs_file"

echo "Checking for binary files..."

while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    range="main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  "$REPO_ROOT/scripts/checks/checkBinaryFiles.sh" --range "$range" </dev/null
done <"$refs_file"

echo "Running Ruby linting..."
bun run lint:ruby

echo "Running bun tests..."
bun run test:turbo:affected


echo "All checks passed."
