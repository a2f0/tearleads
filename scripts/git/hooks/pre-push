#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Source session.sh to get script paths for shellcheck.
. "$REPO_ROOT/scripts/session.sh" "$REPO_ROOT"

if [ -z "$repo_script_paths" ]; then
  echo "Error: repo_script_paths is not defined" >&2
  exit 1
fi

cd "$REPO_ROOT"

echo "Running shellcheck..."
old_ifs=$IFS
IFS='
'

for path_dir in $repo_script_paths; do
  [ -d "$path_dir" ] || continue
  find "$path_dir" -name '*.sh' -exec shellcheck {} +
done

IFS=$old_ifs

find "$REPO_ROOT/scripts/git/hooks" -name '*.sh' -exec shellcheck {} +

echo "Running TypeScript compiler..."
bun tsc --build

echo "Running biome check..."
bun run biome check --error-on-warnings

echo "Running knip..."
bun run knip

echo "Checking for circular imports..."
bun run madge --circular --extensions ts,tsx packages/


echo "Checking file names..."
bun run lint:files

echo "Checking for binary files..."
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  tmpfile=$(mktemp)
  git diff --numstat --diff-filter=ACM "$range" > "$tmpfile"
  while IFS='	' read -r added deleted file; do
    if [ "$added" = "-" ] || [ "$deleted" = "-" ]; then
      echo "ERROR: Binary file detected: $file" >&2
      rm -f "$tmpfile"
      exit 1
    fi
  done < "$tmpfile"
  rm -f "$tmpfile"
done

echo "Running bun tests..."
bun run test:turbo:affected


echo "All checks passed."
