#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# A copied hook must match the checked-out version before it can gate a push.
if ! cmp -s "$0" "$REPO_ROOT/scripts/git/hooks/pre-push"; then
  echo "Error: pre-push hook is stale. Run sh scripts/git/install-hooks.sh." >&2
  exit 1
fi

# shellcheck disable=SC1091
. "$REPO_ROOT/scripts/lib/stepTimings.sh"
# shellcheck disable=SC1091
. "$REPO_ROOT/scripts/checks/fastChecks.sh"

cd "$REPO_ROOT"

push_remote=${1:-}
if ! git remote get-url "$push_remote" >/dev/null 2>&1; then
  echo "Error: push through a configured named remote (for example origin), not a URL." >&2
  exit 1
fi
zero_sha="0000000000000000000000000000000000000000"

refs_file=$(mktemp)
timings_log=$("$REPO_ROOT/scripts/git/showPushGateTimings.sh" --log-path 2>/dev/null) ||
  timings_log=""

# The gate is the slowest thing between finishing work and a merged PR, so every
# run is persisted: `showPushGateTimings.sh` reads it back afterwards, and a run
# that dies mid-check still records which check it died in.
record_timings() {
  [ -n "$timings_log" ] || return 0
  if [ "$1" -eq 0 ]; then
    timings_status=passed
  else
    timings_status=failed
  fi
  # One head= field per commit pushed, so a later reader can ask for the run that
  # gated any of them — a push may carry several refs. A deletion pushes no
  # commit; HEAD then names the run well enough to tell it apart from the others.
  timings_heads=$(awk -v zero="$zero_sha" '$2 != zero { print "head=" $2 }' "$refs_file")
  [ -n "$timings_heads" ] || timings_heads="head=$(git rev-parse HEAD)"
  # Deliberately unquoted: each line is one head= field, and they are hex SHAs.
  # shellcheck disable=SC2086
  step_timings_append_log "$timings_log" \
    "status=$timings_status" \
    "branch=$(git rev-parse --abbrev-ref HEAD)" \
    $timings_heads \
    "remote=${push_remote:-unknown}"
}

# The tests run in the background while the read-only checks run, so the gate
# costs about as long as its longest lane instead of their sum.
tests_pid=""
tests_log="$refs_file.tests.log"

# Lists a process and all its descendants before any is signalled: a killed
# parent's children are re-parented and could no longer be found.
process_tree() {
  printf '%s\n' "$1"
  for process_tree_child in $(pgrep -P "$1" 2>/dev/null); do
    process_tree "$process_tree_child"
  done
}

stop_background_tests() {
  [ -n "$tests_pid" ] || return 0
  echo "Stopping the background tests." >&2
  # shellcheck disable=SC2046
  kill $(process_tree "$tests_pid") 2>/dev/null || true
  wait "$tests_pid" 2>/dev/null || true
  tests_pid=""
}

start_background_tests() {
  tests_started=$(step_timings_now)
  echo "--- [tests] bun run test:turbo:affected (background; log: $tests_log) ---"
  echo ""
  bun run test:turbo:affected </dev/null >"$tests_log" 2>&1 &
  tests_pid=$!
}

finish_background_tests() {
  step_timings_begin tests-wait "Waiting for the background tests"
  tests_status=0
  wait "$tests_pid" || tests_status=$?
  tests_pid=""
  step_timings_end
  echo "--- [tests] output ---"
  cat "$tests_log"
  # Timed from launch, so the row matches a serial run's tests step.
  step_timings_resume tests "$tests_started"
  [ "$tests_status" -eq 0 ] || exit "$tests_status"
  step_timings_end
}

on_exit() {
  push_status=$?
  stop_background_tests
  # Records first: the run's metadata is read out of the refs file.
  record_timings "$push_status" || true
  rm -f "$refs_file" "$tests_log"
}

trap on_exit EXIT
trap 'exit 1' HUP INT TERM

if [ -t 0 ]; then
  : >"$refs_file"
else
  cat >"$refs_file"
fi

step_timings_reset

# Lint the branch names this push creates or updates on the remote. The
# checked-out branch can differ (`git push origin HEAD:other`) or be missing (a
# detached HEAD), and deleting a misnamed branch must stay possible.
pushed_branches=$(awk -v zero="$zero_sha" '
  $2 != zero && index($3, "refs/heads/") == 1 { print substr($3, 12) }
' "$refs_file")
if [ -n "$pushed_branches" ]; then
  step_timings_run branch-name bun run agent-tool branch check --pre-push <"$refs_file"
else
  step_timings_skip branch-name "no branch created or updated"
fi

run_fast_checks_prepare
start_background_tests
run_fast_checks_rest

step_timings_run terraform "$REPO_ROOT/scripts/checks/checkTerraform.sh"

step_timings_run typescript bun tsc --build --pretty false

step_timings_begin commit-trust "Checking commit signatures and co-authors"

while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  # Only new-to-remote commits need admission checks. A normal base merge can
  # include commits already accepted on another remote branch.
  if [ "$remote_sha" = "$zero_sha" ]; then
    bun run agent-tool commits check --range "$local_sha" \
      --exclude main --exclude-remotes "$push_remote" </dev/null
  else
    bun run agent-tool commits check --range "$local_sha" \
      --exclude "$remote_sha" --exclude-remotes "$push_remote" </dev/null
  fi
done <"$refs_file"
step_timings_end

step_timings_begin source-shape "Checking source shape"

while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    range="main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  bun scripts/checks/lintSourceShape.ts --range "$range" </dev/null
done <"$refs_file"
step_timings_end

step_timings_begin binary-files "Checking for binary files"

while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    range="main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  bun run agent-tool checks binaries --range "$range" </dev/null
done <"$refs_file"
step_timings_end

finish_background_tests

step_timings_summary

echo "All checks passed."
