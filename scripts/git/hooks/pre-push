#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "Running cargo tests..."
cargo test

echo "Running WASM tests..."
bun test

echo "Running linter..."
cargo clippy -- -D warnings

echo "Running shellcheck..."
find "$REPO_ROOT/scripts" -name '*.sh' -exec shellcheck {} +

echo "All checks passed."
