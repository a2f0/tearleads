#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Source session.sh to get script paths for shellcheck.
tearleads_repo_root=$REPO_ROOT
. "$REPO_ROOT/scripts/session.sh"

if [ -z "$repo_script_paths" ]; then
  echo "Error: repo_script_paths is not defined" >&2
  exit 1
fi

cd "$REPO_ROOT"

refs_file=$(mktemp)
trap 'rm -f "$refs_file"' EXIT
trap 'exit 1' HUP INT TERM

if [ -t 0 ]; then
  : >"$refs_file"
else
  cat >"$refs_file"
fi

echo "Linting branch name..."
bun run lint:branch-name

echo "Running shellcheck..."
old_ifs=$IFS
IFS='
'

for path_dir in $repo_script_paths; do
  [ -d "$path_dir" ] || continue
  find "$path_dir" -name '*.sh' -exec shellcheck {} +
done

IFS=$old_ifs

find "$REPO_ROOT/scripts/git/hooks" -name '*.sh' -exec shellcheck {} +

echo "Running TypeScript compiler..."
bun tsc --build --pretty false

echo "Running biome check..."
bun run lint:biome

echo "Checking package type assertions..."
bun run lint:package-assertions

echo "Running knip..."
bun run lint:knip:all

echo "Running production knip..."
bun run lint:knip:production

echo "Checking dependency graph and architecture boundaries..."
bun run lint:architecture

echo "Checking file names..."
bun run lint:files

echo "Checking file size limits..."
zero_sha="0000000000000000000000000000000000000000"

while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    range="main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  "$REPO_ROOT/scripts/checks/checkFileLimits.sh" --range "$range" </dev/null
done <"$refs_file"

echo "Checking for binary files..."

while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    range="main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  "$REPO_ROOT/scripts/checks/checkBinaryFiles.sh" --range "$range" </dev/null
done <"$refs_file"

echo "Running bun tests..."
bun run test:turbo:affected


echo "All checks passed."
