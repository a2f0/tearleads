{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "extends": ["../../biome.jsonc"],
  "linter": {
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false,
            "hooks": [
              {
                "name": "useRuntimeScopedMemo",
                "closureIndex": 0,
                "dependenciesIndex": 1
              }
            ]
          }
        }
      }
    }
  }
}
