# intake: Brings new third-party code into the repository.
prefix_rule(pattern=["bun", "run", "agent-tool", "bun", "add"], decision="prompt", justification="Brings new third-party code into the repository.", match=["bun run agent-tool bun add"])
prefix_rule(pattern=["node_modules/.bin/agent-tool", "bun", "add"], decision="prompt", justification="Brings new third-party code into the repository.", match=["node_modules/.bin/agent-tool bun add"])
prefix_rule(pattern=["agent-tool", "bun", "add"], decision="prompt", justification="Brings new third-party code into the repository.", match=["agent-tool bun add"])
prefix_rule(pattern=["bun", ["add", "a", "x"]], decision="prompt", justification="Brings new third-party code into the repository.", match=["bun add"])
prefix_rule(pattern=["npm", ["install", "i", "add"]], decision="prompt", justification="Brings new third-party code into the repository.", match=["npm install"])
prefix_rule(pattern=["pnpm", "add"], decision="prompt", justification="Brings new third-party code into the repository.", match=["pnpm add"])
prefix_rule(pattern=["yarn", "add"], decision="prompt", justification="Brings new third-party code into the repository.", match=["yarn add"])
prefix_rule(pattern=[["bunx", "npx"]], decision="prompt", justification="Brings new third-party code into the repository.", match=["bunx"])

# policy: Changes the permissions agents run with.
prefix_rule(pattern=["bun", "run", "agent-tool", "permissions", "install"], decision="prompt", justification="Changes the permissions agents run with.", match=["bun run agent-tool permissions install"])
prefix_rule(pattern=["node_modules/.bin/agent-tool", "permissions", "install"], decision="prompt", justification="Changes the permissions agents run with.", match=["node_modules/.bin/agent-tool permissions install"])
prefix_rule(pattern=["agent-tool", "permissions", "install"], decision="prompt", justification="Changes the permissions agents run with.", match=["agent-tool permissions install"])
