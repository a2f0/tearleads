# share: Publishes work for review without changing a shared branch: pushes a feature branch, opens a PR, answers review threads, or prunes a merged PR's feature branch.
prefix_rule(pattern=["bun", "run", "agent-tool", "branch", "push"], decision="allow", match=["bun run agent-tool branch push"])
