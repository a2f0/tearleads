prefix_rule(pattern=["agent-tool", "pr", "open"], decision="allow", match=["agent-tool pr open"])
prefix_rule(pattern=["agent-tool", "pr", "threads", ["reply", "resolve"]], decision="allow", match=["agent-tool pr threads reply"])
prefix_rule(pattern=["agent-tool", "openPr"], decision="allow", match=["agent-tool openPr"])

# release: Merges into a shared branch, publishes a package, or deletes remote state.
prefix_rule(pattern=["bun", "run", "agent-tool", "pr", "merge"], decision="prompt", justification="Merges into a shared branch, publishes a package, or deletes remote state.", match=["bun run agent-tool pr merge"])
prefix_rule(pattern=["bun", "run", "agent-tool", "repo", "cleanup"], decision="prompt", justification="Merges into a shared branch, publishes a package, or deletes remote state.", match=["bun run agent-tool repo cleanup"])
prefix_rule(pattern=["bun", "run", "agent-tool", "squashMerge"], decision="prompt", justification="Merges into a shared branch, publishes a package, or deletes remote state.", match=["bun run agent-tool squashMerge"])
prefix_rule(pattern=["bun", "run", "agent-tool", "bun", "x", "wrangler"], decision="prompt", justification="Merges into a shared branch, publishes a package, or deletes remote state.", match=["bun run agent-tool bun x wrangler"])
prefix_rule(pattern=["node_modules/.bin/agent-tool", "pr", "merge"], decision="prompt", justification="Merges into a shared branch, publishes a package, or deletes remote state.", match=["node_modules/.bin/agent-tool pr merge"])
