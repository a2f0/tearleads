# local: Changes only this checkout: files, local branches, lockfile installs, and versions of declared or already-resolved dependencies.
prefix_rule(pattern=["bun", "run", "agent-tool", "bun", ["install", "update", "remove", "test"]], decision="allow", match=["bun run agent-tool bun install"])
prefix_rule(pattern=["bun", "run", "agent-tool", "branch", "create"], decision="allow", match=["bun run agent-tool branch create"])
prefix_rule(pattern=["bun", "run", "agent-tool", "versions", ["bump", "prepare", "resolve-conflicts"]], decision="allow", match=["bun run agent-tool versions bump"])
prefix_rule(pattern=["bun", "run", "agent-tool", "images", "build"], decision="allow", match=["bun run agent-tool images build"])
prefix_rule(pattern=["bun", "run", "agent-tool", "screenshots", "build"], decision="allow", match=["bun run agent-tool screenshots build"])
