prefix_rule(pattern=["node_modules/.bin/agent-tool", "bun", "x", "wrangler"], decision="prompt", justification="Merges into a shared branch, publishes a package, or deletes remote state.", match=["node_modules/.bin/agent-tool bun x wrangler"])
prefix_rule(pattern=["agent-tool", "pr", "merge"], decision="prompt", justification="Merges into a shared branch, publishes a package, or deletes remote state.", match=["agent-tool pr merge"])
prefix_rule(pattern=["agent-tool", "repo", "cleanup"], decision="prompt", justification="Merges into a shared branch, publishes a package, or deletes remote state.", match=["agent-tool repo cleanup"])
prefix_rule(pattern=["agent-tool", "squashMerge"], decision="prompt", justification="Merges into a shared branch, publishes a package, or deletes remote state.", match=["agent-tool squashMerge"])
