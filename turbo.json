{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "concurrency": "2",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": ["tsconfig.base.json", "patches/**"],
  "globalEnv": ["CI_TOOLCHAIN"],
  "tasks": {
    "//#test:architecture": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "pkg/**"]
    },
    "check": {
      "outputs": []
    },
    "sources": {
      "description": "Hash-only: no package defines this script. Depend on <package>#sources to key a task on that package's files and its workspace dependencies without building them.",
      "dependsOn": ["^sources"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.turbo/**",
        "!dist/**",
        "!pkg/**",
        "!**/*.tsbuildinfo",
        "!**/.DS_Store"
      ]
    },
    "e2e": {
      "passThroughEnv": ["APP_WEB_PORT"],
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.turbo/**",
        "!dist/**",
        "!playwright-report/**",
        "!test-results/**",
        "!**/*.tsbuildinfo",
        "!**/.DS_Store"
      ]
    }
  }
}
