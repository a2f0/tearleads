{
  "$schema": "https://turborepo.com/schema.json",
  "concurrency": "1",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "pkg/**"]
    },
    "check": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.turbo/**",
        "!dist/**",
        "!pkg/**",
        "!**/*.tsbuildinfo",
        "!**/.DS_Store"
      ]
    },
    "e2e": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.turbo/**",
        "!dist/**",
        "!playwright-report/**",
        "!test-results/**",
        "!**/*.tsbuildinfo",
        "!**/.DS_Store"
      ]
    }
  }
}
