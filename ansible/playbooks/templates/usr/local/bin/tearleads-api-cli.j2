#!/bin/sh
# {{ ansible_managed }}
#
# Operator entry point for the deployed API CLI. The executable at
# /opt/tearleads/bin/tearleads-api-cli reads its database and object-store
# settings from the environment. Migrations use a separate, root-only env file;
# run them with `sudo tearleads-api-cli migrate`. Other commands use the API
# environment without exposing its secrets to the login shell.
set -eu

env_file=/etc/tearleads/api.env
if [ "${1:-}" = migrate ]; then
  env_file=/etc/tearleads/migrations.env
fi
cli=/opt/tearleads/bin/tearleads-api-cli

if [ ! -r "$env_file" ]; then
  echo "$env_file is not readable; run migrations as root, other commands as the deploy user" >&2
  exit 1
fi
if [ ! -x "$cli" ]; then
  echo "$cli is not installed; deploy the API CLI first" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
. "$env_file"
set +a

exec "$cli" "$@"
