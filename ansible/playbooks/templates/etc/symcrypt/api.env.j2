NODE_ENV=production
API_HOST=127.0.0.1
API_DATABASE=postgres
POSTGRES_HOST={{ postgres_host }}
POSTGRES_PORT={{ postgres_port | default('5432') }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DATABASE={{ postgres_db }}
REDIS_URL=redis://{{ redis_bind }}:6379
API_CORS_ORIGINS={{ api_cors_origins }}
DOCUMENT_SYNC_CURSOR_HMAC_KEY={{ document_sync_cursor_hmac_key | quote }}
{% if revenuecat_webhook_auth_header | default('') != '' %}
{# Shell-quoted: /etc/symcrypt/api.env is both a systemd EnvironmentFile and
   sourced by the deploy scripts (set -a && . api.env). A header value with a
   space (e.g. "Bearer <token>") would otherwise break the shell source. #}
REVENUECAT_WEBHOOK_AUTH_HEADER={{ revenuecat_webhook_auth_header | quote }}
{% endif %}
{# RevenueCat REST API v2 credentials — the server uses these to resolve an org's
   subscription-management URL from its stored customer id. Both are required for
   that lookup; absent, the manage-subscription button is simply hidden. #}
{% if revenuecat_v2_secret_key | default('') != '' %}
REVENUECAT_V2_SECRET_KEY={{ revenuecat_v2_secret_key | quote }}
{% endif %}
{% if revenuecat_project_id | default('') != '' %}
REVENUECAT_PROJECT_ID={{ revenuecat_project_id | quote }}
{% endif %}
{# Whether this tier applies RevenueCat events marked SANDBOX — StoreKit
   sandbox, TestFlight, and Play internal-testing purchases, which are free to
   the tester but otherwise indistinguishable from paid ones. Only render the
   opt-in when the tier explicitly asks for it: the server fails closed, so
   production simply omits this and ignores those events. Set it on the tier
   where native purchases are exercised. #}
{% if revenuecat_allow_sandbox_events | default('') | trim == 'true' %}
REVENUECAT_ALLOW_SANDBOX_EVENTS="true"
{% endif %}
{# Direct Stripe checkout (issue #1654): the server creates subscriptions on
   our own Stripe account and associates them with RevenueCat. The flow needs
   all four rendered here PLUS the REVENUECAT_V2_SECRET_KEY +
   REVENUECAT_PROJECT_ID pair rendered above (reused from the management-URL
   lookup); absent, the direct-checkout routes answer 503 and the Stripe
   webhook fails closed. #}
{% if stripe_secret_key | default('') != '' %}
STRIPE_SECRET_KEY={{ stripe_secret_key | quote }}
{% endif %}
{% if stripe_webhook_secret | default('') != '' %}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret | quote }}
{% endif %}
{% if stripe_sync_solo_price_id | default('') != '' %}
STRIPE_SYNC_SOLO_PRICE_ID={{ stripe_sync_solo_price_id | quote }}
{% endif %}
{% if stripe_sync_team_5_price_id | default('') != '' %}
STRIPE_SYNC_TEAM_5_PRICE_ID={{ stripe_sync_team_5_price_id | quote }}
{% endif %}
{% if stripe_sync_team_10_price_id | default('') != '' %}
STRIPE_SYNC_TEAM_10_PRICE_ID={{ stripe_sync_team_10_price_id | quote }}
{% endif %}
{% if revenuecat_stripe_public_api_key | default('') != '' %}
REVENUECAT_STRIPE_PUBLIC_API_KEY={{ revenuecat_stripe_public_api_key | quote }}
{% endif %}
BLOB_OBJECT_STORE={{ blob_object_store | default('memory') }}
{% if blob_object_store | default('') == 's3' %}
BLOB_OBJECT_STORE_S3_BUCKET={{ blob_s3_bucket | default('') }}
BLOB_OBJECT_STORE_S3_REGION={{ blob_s3_region | default('') }}
BLOB_OBJECT_STORE_S3_ENDPOINT={{ blob_s3_endpoint | default('') }}
BLOB_OBJECT_STORE_S3_FORCE_PATH_STYLE={{ blob_s3_force_path_style | default('true') }}
BLOB_OBJECT_STORE_S3_ACCESS_KEY_ID={{ blob_s3_access_key_id | default('') }}
BLOB_OBJECT_STORE_S3_SECRET_ACCESS_KEY={{ blob_s3_secret_access_key | default('') }}
{% if blob_s3_key_prefix | default('') != '' %}
BLOB_OBJECT_STORE_S3_KEY_PREFIX={{ blob_s3_key_prefix }}
{% endif %}
{% endif %}
