[Unit]
Description=Report Tearleads maintenance failure for %i

[Service]
Type=oneshot
User={{ server_user | default('deploy') }}
EnvironmentFile=-/etc/tearleads/blob-gc-healthcheck.env
ExecStart=-/usr/local/bin/tearleads-blob-gc-healthcheck fail
ExecStart=/usr/bin/logger -p daemon.alert -t tearleads-maintenance-alert "Tearleads maintenance unit %i failed"
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
