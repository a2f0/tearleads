[Unit]
Description=SymCrypt API
After=network.target postgresql.service redis-server.service{{ ' garage.service' if garage_enabled | default(false) | bool else '' }}
Wants=postgresql.service redis-server.service{{ ' garage.service' if garage_enabled | default(false) | bool else '' }}

[Service]
Type=simple
User={{ server_user | default('deploy') }}
WorkingDirectory=/opt/symcrypt
EnvironmentFile=/etc/symcrypt/api.env
ExecStart=/opt/symcrypt/bin/symcrypt-api
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=symcrypt-api
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/symcrypt

[Install]
WantedBy=multi-user.target
