[Unit]
Description=Tearleads Blob GC
After=network.target postgresql.service redis-server.service{{ ' garage.service' if garage_enabled | default(false) | bool else '' }}
Wants=postgresql.service redis-server.service{{ ' garage.service' if garage_enabled | default(false) | bool else '' }}
ConditionPathExists=/opt/tearleads/bin/tearleads-blob-gc

[Service]
Type=oneshot
User={{ server_user | default('deploy') }}
WorkingDirectory=/opt/tearleads
EnvironmentFile=/etc/tearleads/api.env
ExecStart=/opt/tearleads/bin/tearleads-blob-gc
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tearleads-blob-gc
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/tearleads
