[Unit]
Description=Tearleads Blob GC
After=network.target postgresql.service redis-server.service{{ ' garage.service' if garage_enabled | default(false) | bool else '' }}
Wants=postgresql.service redis-server.service{{ ' garage.service' if garage_enabled | default(false) | bool else '' }}
OnFailure=tearleads-maintenance-alert@%n.service

[Service]
Type=oneshot
User={{ server_user | default('deploy') }}
WorkingDirectory=/opt/tearleads
EnvironmentFile=/etc/tearleads/api.env
EnvironmentFile=/etc/tearleads/blob-gc-healthcheck.env
ExecStartPre=-/usr/bin/curl --fail --silent --show-error --output /dev/null --connect-timeout 5 --max-time 10 --retry 3 --retry-all-errors "${BLOB_GC_HEALTHCHECK_URL}/start"
ExecStart=/opt/tearleads/bin/tearleads-blob-gc
ExecStartPost=-/usr/bin/curl --fail --silent --show-error --output /dev/null --connect-timeout 5 --max-time 10 --retry 3 --retry-all-errors "${BLOB_GC_HEALTHCHECK_URL}"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tearleads-blob-gc
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/tearleads
