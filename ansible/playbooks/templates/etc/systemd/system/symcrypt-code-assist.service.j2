[Unit]
Description=SymCrypt Code Assist
After=network.target
Wants=network.target

[Service]
Type=simple
User={{ server_user | default('deploy') }}
WorkingDirectory=/opt/symcrypt
EnvironmentFile=/etc/symcrypt/code-assist.env
ExecStart=/opt/symcrypt/bin/symcrypt-code-assist
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=symcrypt-code-assist
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/symcrypt

[Install]
WantedBy=multi-user.target
