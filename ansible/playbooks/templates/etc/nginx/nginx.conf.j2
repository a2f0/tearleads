user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;

events {
  worker_connections {{ nginx_worker_connections }};
}

http {
  sendfile on;
  tcp_nopush on;
  types_hash_max_size 2048;

  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;

  access_log /var/log/nginx/access.log;

  gzip on;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  # Without an explicit default server nginx falls back to the first server
  # block it parses -- alphabetically api.conf -- so a hostname routed here by
  # DNS and tunnel ingress but missing from every server_name would reach the
  # API proxy. Refuse it here instead, before the sites are included.
  server {
    listen 127.0.0.1:80 default_server;
    listen [::1]:80 default_server;
    server_name _;
    return 444;
  }

  include /etc/nginx/conf.d/*.conf;
  include /etc/nginx/sites-enabled/*;
}
