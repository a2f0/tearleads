# {{ ansible_managed }}
# Static application server block for {{ app_hostname }}

{% macro static_app_server(hostnames, root_path) -%}
server {
  listen 127.0.0.1:80;
  listen [::1]:80;
  server_name {{ hostnames | join(' ') }};

  root {{ root_path }};
  index index.html;

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location = /worker.js {
    try_files $uri =404;
    add_header Cache-Control "no-cache";
  }

  location = /sqlite3.wasm {
    try_files $uri =404;
    add_header Cache-Control "no-cache";
  }

  # The service worker must revalidate on every load so clients pick up new
  # versions promptly; the worker itself precaches the (immutable, hashed)
  # assets for offline use.
  location = /sw.js {
    try_files $uri =404;
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|wasm)$ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
}
{%- endmacro %}

{{ static_app_server([app_hostname], '/var/www/app-web') }}
