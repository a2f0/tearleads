# {{ ansible_managed }}
# Application server block for {{ domain | default('tearleads.com') }}

server {
  listen 80;
  listen [::]:80;
  server_name app.{{ domain | default('tearleads.com') }} api.{{ domain | default('tearleads.com') }};

  {% if certbot_ssl | default(false) %}
  listen 443 ssl;
  listen [::]:443 ssl;
  ssl_certificate /etc/letsencrypt/live/{{ domain | default('tearleads.com') }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ domain | default('tearleads.com') }}/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
  {% endif %}

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
  }
}
