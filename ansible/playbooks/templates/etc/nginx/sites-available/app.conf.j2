# {{ ansible_managed }}
# Static application server block for {{ domain | default('tearleads.com') }}

server {
  listen 80;
  listen [::]:80;
  server_name app.{{ domain | default('tearleads.com') }};

  {% if certbot_ssl | default(false) %}
  listen 443 ssl;
  listen [::]:443 ssl;
  ssl_certificate /etc/letsencrypt/live/{{ domain | default('tearleads.com') }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ domain | default('tearleads.com') }}/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
  {% endif %}

  root /var/www/app-web;
  index index.html;

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location = /worker.js {
    try_files $uri =404;
    add_header Cache-Control "no-cache";
  }

  location = /sqlite3.wasm {
    try_files $uri =404;
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|wasm)$ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
}
