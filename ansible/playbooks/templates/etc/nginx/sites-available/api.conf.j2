# {{ ansible_managed }}
# API server block for {{ api_hostname }}

map $http_origin $document_sync_cors_origin {
{% if api_cors_origins | trim == '*' %}
  default "*";
{% else %}
  default "";
{% set configured_api_cors_origins = api_cors_origins.split(',') | map('trim') | reject('equalto', '') | unique | list %}
{% for api_cors_origin in configured_api_cors_origins %}
  {{ api_cors_origin | trim | to_json }} $http_origin;
{% endfor %}
{% endif %}
}

server {
  listen 127.0.0.1:80;
  listen [::1]:80;
  server_name {{ api_hostname }};

  client_max_body_size 100M;

{% if code_assist_enabled | bool %}
  location = /code-assist/health {
    proxy_pass http://127.0.0.1:{{ code_assist_port }}/health;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /code-assist/webhook {
    proxy_pass http://127.0.0.1:{{ code_assist_port }}/webhook;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
{% endif %}

  location ~ ^/documents/.+/sync$ {
    # Nginx selects regex locations against the normalized URI, so encoded
    # separators cannot evade the sync body's 16 MiB ceiling. Link/unlink keep
    # the server-wide ceiling because rotation baselines can legitimately be
    # larger than a sync request.
    # This mirrors MAX_DOCUMENT_SYNC_REQUEST_BYTES and keeps Bun's native
    # buffered read bounded without using its unstable request-stream reader.
    client_max_body_size 16M;
    error_page 413 = @document_sync_body_too_large;
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 86400s;
  }

  location @document_sync_body_too_large {
    internal;
    default_type application/json;
    add_header Access-Control-Allow-Origin $document_sync_cors_origin always;
    add_header Vary Origin always;
    return 413 '{"error":"Request body too large"}';
  }

  location / {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 86400s;
  }
}
