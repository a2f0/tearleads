# {{ ansible_managed }}
# Static website server block for {{ domain | default('tearleads.com') }}

server {
  listen 127.0.0.1:80;
  listen [::1]:80;
  server_name {{ domain | default('tearleads.com') }};

  root /var/www/website;
  index index.html;

  # Cloudflare is configured to make this host cache-eligible and to respect
  # these origin headers (see the cache ruleset in terraform/modules/
  # cloudflare-website-cache), so per-path policy lives here rather than being
  # split between nginx and the edge.

  # HTML: cacheable at the edge, never in the browser. `s-maxage` lets the edge
  # hold pages so a request from outside Europe does not cross the Atlantic to
  # this origin, while `max-age=0, must-revalidate` keeps browsers asking — a
  # deploy purges the edge, but it cannot reach a browser copy.
  location / {
    try_files $uri $uri/ =404;
    add_header Cache-Control "public, max-age=0, s-maxage=3600, must-revalidate";
  }

  # The gallery manifest carries the content-versioned image URLs, so it is the
  # one file that must always revalidate: a stale manifest pins every image to
  # its previous version, which is exactly the staleness the versioning exists
  # to prevent. Stated explicitly rather than relying on `.json` being absent
  # from the immutable regex below.
  location = /screenshot-gallery/manifest.json {
    expires off;
    add_header Cache-Control "public, no-cache, must-revalidate";
  }

  # Long-lived assets. Safe for the screenshot gallery too: buildScreenshots.ts
  # keys each image URL on a digest of its bytes, so a recaptured screen is a
  # new URL rather than new bytes at an old one — the same contract as Astro's
  # hashed output.
  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
}
