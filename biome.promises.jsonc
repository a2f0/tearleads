{
  // Biome's 2.5.15 migration added this to the explicit promises config.
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "packages/{api,app,client-sdk,crypto,diagnostics}/src/**",
      "!**/*.test.{ts,tsx}",
      "!**/*.{testUtils,testFixtures}.{ts,tsx}",
      "!**/{testUtils,testFixtures}.{ts,tsx}",
      "!**/*TestFixtures.{ts,tsx}",
      "!packages/api/src/appTestRuntime.ts",
      "!**/{test,tests,testUtils,testFixtures}/**",
      "!!docs/openapi.json",
      // Generated contracts are verified by lint:openapi. Exclude this file
      // from type scanning to avoid Biome's generated-type count limit.
      "!!packages/validators/src/operation/generatedOpenApi.ts"
    ]
  },
  "linter": {
    "rules": {
      "preset": "none",
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  }
}
