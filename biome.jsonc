{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // Scope artifacts contain complete repository snapshots with their own roots.
      "!!.scope",
      "!!docs/openapi.json",
      // Generated, fully inlined, and neither formatted nor linted below: do
      // not read it at all rather than warn about its size as the API grows.
      "!!packages/validators/src/operation/generatedOpenApi.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 75,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "noExcessiveNestedTestSuites": "error",
        "noUselessReturn": "error"
      },
      // React rules are listed explicitly: Biome's react domain does not detect
      // React from the root manifest, so none of them run otherwise.
      "correctness": {
        "noChildrenProp": "error",
        "noGlobalDirnameFilename": "error",
        "noReactPropAssignments": "error",
        "noRenderReturnValue": "error",
        "useJsxKeyInIterable": "error",
        "useUniqueElementIds": "error",
        // Revision counters and scope keys are listed on purpose to re-run a
        // hook, so only missing dependencies are reported. The custom hooks
        // below return a useRef object, which never changes identity.
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false,
            "hooks": [
              {
                "name": "useRuntimeScopedMemo",
                "closureIndex": 0,
                "dependenciesIndex": 1
              },
              { "name": "useAllowedRef", "stableResult": true },
              {
                "name": "useCommittedAttributionHydrationScope",
                "stableResult": true
              },
              {
                "name": "useContainerInfoOrganizationGroups",
                "stableResult": true
              },
              { "name": "useLatestImporter", "stableResult": true },
              { "name": "useMountedRef", "stableResult": true }
            ]
          }
        }
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error"
      },
      "suspicious": {
        // dependency-cruiser's no-circular covers package source only; this
        // also covers scripts/ and test helpers. Type-only imports count too,
        // since they still tangle the modules a reader has to hold together.
        "noImportCycles": {
          "level": "error",
          "options": { "ignoreTypes": false }
        },
        // Catches operands that never change the result, such as `false || x`,
        // before esbuild only warns about them during a Worker deploy.
        "noConstantBinaryExpressions": "error",
        "noAlert": "error",
        "noDuplicateDependencies": "error",
        "noDuplicatedSpreadProps": "error",
        "noDuplicateTestHooks": "error",
        "noEmptySource": "error",
        "noExportsInTest": "error",
        "noReactForwardRef": "error",
        "noReturnAssign": "error",
        "noSkippedTests": "error",
        "noUnassignedVariables": "error",
        "noUnknownAttribute": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useGuardForIn": "error",
        "useNumberToFixedDigitsArgument": "error"
      },
      "style": {
        // Component variants intentionally group selectors by behavior; preserve
        // their cascade instead of adopting Biome 2.5 specificity ordering.
        "noDescendingSpecificity": "off",
        "noUselessElse": "error",
        "useCollapsedIf": "error",
        "useDefaultParameterLast": "error",
        "useReactFunctionComponents": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@tearleads/api": "Do not import from the API server package",
              "hono/compress": "Do not compress responses in app code: Cloudflare compresses them at the edge, and the Workers runtime encodes a body again to match the Content-Encoding the app set (double gzip)",
              "app-web": "Do not import from app-web — it is a deployment target",
              "app-capacitor": "Do not import from app-capacitor — it is a deployment target",
              "app-electrobun": "Do not import from app-electrobun — it is a deployment target",
              "website": "Do not import from website — it is a deployment target"
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/app/src/**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 12
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/website/src/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.testUtils.ts",
        "**/*.testUtils.tsx",
        "packages/api/test/**/*.ts",
        "packages/client-sdk/test/helpers/**/*.ts",
        "packages/app/test/helpers/**/*.ts",
        "packages/app/test/helpers/**/*.tsx",
        "packages/test-utils/src/**/*.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      // Outside test files noFocusedTests mistakes helpers named `fit` for
      // Jasmine's focused `it`. An isolated test render owns the whole
      // document, so fixed element IDs cannot collide there.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "correctness": { "useUniqueElementIds": "off" },
          "suspicious": { "noFocusedTests": "error" }
        }
      }
    },
    {
      "includes": [
        "packages/app-capacitor/ios/**/Assets.xcassets/**",
        "packages/app-capacitor/android/**"
      ],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": [
        "docs/openapi.json",
        "formal/document-sync/BaselineDominanceTraces.json",
        "formal/lean/lake-manifest.json",
        "formal/lean/vectors/transparency.json"
      ],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
