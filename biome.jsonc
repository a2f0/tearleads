{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useLiteralKeys": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@tearleads/api": "Do not import from the API server package",
              "app-web": "Do not import from app-web — it is a deployment target",
              "app-electrobun": "Do not import from app-electrobun — it is a deployment target"
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  // Bracket notation is required in validators because type guards narrow
  // through Record<string, unknown>, and tsconfig's noPropertyAccessFromIndexSignature
  // forbids dot access on index signatures.
  "overrides": [
    {
      "includes": ["packages/validators/**", "packages/api/src/validators/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
