{
  // The glob lives in the `lint:markdown` script, not here: config `globs` are
  // *appended* to any paths given on the command line, so setting them here
  // would make `lint-staged` re-lint (and --fix) the whole tree on every commit
  // instead of just the staged files.
  //
  // The lint command passes tracked Markdown files explicitly. Glob ignores
  // would traverse generated native symlink trees before matching those paths.
  "gitignore": false,
  "config": {
    "default": true,
    // Prose wraps at 80 columns. Code samples, shell transcripts, and tables
    // carry their own formatting and cannot be rewrapped without changing what
    // they mean, so they are measured by their own rules instead.
    "MD013": {
      "code_blocks": false,
      "tables": false
    }
  }
}
